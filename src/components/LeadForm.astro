---
/*
  REUSABLE LEAD FORM
  Single form component used across the entire site. Import this everywhere
  instead of writing inline forms. Supports two variants:
  
  - "full" (default): name, email, phone, company, service, budget, start date, message
  - "compact": name, phone, email, message (smaller footprint for CTAs/sidebars)
  
  Forms open a message to siteConfig.email. No third-party lead API.
  Use a unique formId when placing multiple forms on the same page.
*/
import { siteConfig } from "../config/siteConfig";

interface Props {
  formId?: string;
  variant?: "full" | "compact";
  showServiceDropdown?: boolean;
  submitLabel?: string;
  messagePlaceholder?: string;
}

const {
  formId = "lead-form",
  variant = "full",
  showServiceDropdown = true,
  submitLabel = "Submit",
  messagePlaceholder = "Tell me about your project...",
} = Astro.props;

const isFull = variant === "full";
const contactEmail = siteConfig.email;
---

<form id={formId} class="space-y-4" novalidate>
  {isFull ? (
    <!-- Full: First Name / Last Name side by side -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label for={`${formId}-firstName`} class="block text-xs font-semibold text-text-muted mb-1">First Name *</label>
        <input
          type="text"
          id={`${formId}-firstName`}
          name="firstName"
          required
          autocomplete="given-name"
          class="w-full rounded-lg border border-border bg-surface px-3.5 py-2.5 text-sm text-text placeholder:text-text-muted focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-colors"
          placeholder="First name"
        />
      </div>
      <div>
        <label for={`${formId}-lastName`} class="block text-xs font-semibold text-text-muted mb-1">Last Name *</label>
        <input
          type="text"
          id={`${formId}-lastName`}
          name="lastName"
          required
          autocomplete="family-name"
          class="w-full rounded-lg border border-border bg-surface px-3.5 py-2.5 text-sm text-text placeholder:text-text-muted focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-colors"
          placeholder="Last name"
        />
      </div>
    </div>
  ) : (
    <!-- Compact: Single name field -->
    <div>
      <label for={`${formId}-name`} class="block text-xs font-semibold text-text-muted mb-1">Name *</label>
      <input
        type="text"
        id={`${formId}-name`}
        name="name"
        required
        autocomplete="name"
        class="w-full rounded-lg border border-border bg-surface px-3.5 py-2.5 text-sm text-text placeholder:text-text-muted focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-colors"
        placeholder="Your name"
      />
    </div>
  )}

  {isFull ? (
    <!-- Full: Phone and Email side by side -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label for={`${formId}-phone`} class="block text-xs font-semibold text-text-muted mb-1">Phone *</label>
        <input
          type="tel"
          id={`${formId}-phone`}
          name="phone"
          required
          autocomplete="tel"
          class="w-full rounded-lg border border-border bg-surface px-3.5 py-2.5 text-sm text-text placeholder:text-text-muted focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-colors"
          placeholder="+63 900 000 0000"
        />
      </div>
      <div>
        <label for={`${formId}-email`} class="block text-xs font-semibold text-text-muted mb-1">Email *</label>
        <input
          type="email"
          id={`${formId}-email`}
          name="email"
          required
          autocomplete="email"
          class="w-full rounded-lg border border-border bg-surface px-3.5 py-2.5 text-sm text-text placeholder:text-text-muted focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-colors"
          placeholder="you@company.com"
        />
      </div>
    </div>
  ) : (
    <!-- Compact: Phone and Email stacked -->
    <div>
      <label for={`${formId}-phone`} class="block text-xs font-semibold text-text-muted mb-1">Phone *</label>
      <input
        type="tel"
        id={`${formId}-phone`}
        name="phone"
        required
        autocomplete="tel"
        class="w-full rounded-lg border border-border bg-surface px-3.5 py-2.5 text-sm text-text placeholder:text-text-muted focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-colors"
        placeholder="+63 900 000 0000"
      />
    </div>
    <div>
      <label for={`${formId}-email`} class="block text-xs font-semibold text-text-muted mb-1">Email *</label>
      <input
        type="email"
        id={`${formId}-email`}
        name="email"
        required
        autocomplete="email"
        class="w-full rounded-lg border border-border bg-surface px-3.5 py-2.5 text-sm text-text placeholder:text-text-muted focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-colors"
        placeholder="you@company.com"
      />
    </div>
  )}

  {isFull && (
    <div>
      <label for={`${formId}-company`} class="block text-xs font-semibold text-text-muted mb-1">Company / Business Name</label>
      <input
        type="text"
        id={`${formId}-company`}
        name="company"
        autocomplete="organization"
        class="w-full rounded-lg border border-border bg-surface px-3.5 py-2.5 text-sm text-text placeholder:text-text-muted focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-colors"
        placeholder="Your business name"
      />
    </div>
  )}

  {showServiceDropdown && (
    <div>
      <label for={`${formId}-service`} class="block text-xs font-semibold text-text-muted mb-1">Service Needed *</label>
      <select
        id={`${formId}-service`}
        name="service"
        required
        class="w-full rounded-lg border border-border bg-surface px-3.5 py-2.5 text-sm text-text focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-colors"
      >
        <option value="">Select a service...</option>
        <slot name="service-options" />
      </select>
    </div>
  )}

  {isFull && (
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label for={`${formId}-budget`} class="block text-xs font-semibold text-text-muted mb-1">Budget Range</label>
        <select
          id={`${formId}-budget`}
          name="budget"
          class="w-full rounded-lg border border-border bg-surface px-3.5 py-2.5 text-sm text-text focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-colors"
        >
          <option value="">Select a range...</option>
          <option value="Under $1,000">Under $1,000</option>
          <option value="$1,000 to $3,000">$1,000 to $3,000</option>
          <option value="$3,000 to $5,000">$3,000 to $5,000</option>
          <option value="$5,000+">$5,000+</option>
          <option value="Not sure yet">Not sure yet</option>
        </select>
      </div>
      <div>
        <label for={`${formId}-startDate`} class="block text-xs font-semibold text-text-muted mb-1">Preferred Start Date</label>
        <input
          type="text"
          id={`${formId}-startDate`}
          name="startDate"
          class="w-full rounded-lg border border-border bg-surface px-3.5 py-2.5 text-sm text-text placeholder:text-text-muted focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-colors"
          placeholder="ASAP, next month, Q4..."
        />
      </div>
    </div>
  )}

  <div>
    <label for={`${formId}-message`} class="block text-xs font-semibold text-text-muted mb-1">
      {isFull ? "Project Details" : "Message *"}
    </label>
    <textarea
      id={`${formId}-message`}
      name="message"
      rows={isFull ? 3 : 3}
      required={!isFull}
      class="w-full rounded-lg border border-border bg-surface px-3.5 py-2.5 text-sm text-text placeholder:text-text-muted focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-colors resize-y"
      placeholder={messagePlaceholder}
    ></textarea>
  </div>

  <button
    type="submit"
    class="w-full rounded-lg bg-secondary px-6 py-3 text-base font-bold text-white shadow-sm hover:bg-secondary-light transition-colors focus:outline-none focus:ring-2 focus:ring-secondary/50 focus:ring-offset-2"
  >
    {submitLabel}
  </button>
</form>

<script is:inline define:vars={{ formId, contactEmail }}>
  (function () {
    const form = document.getElementById(formId);
    if (!form || !(form instanceof HTMLFormElement)) return;

    form.addEventListener("submit", function (e) {
      e.preventDefault();
      const data = Object.fromEntries(new FormData(form));
      const name = [data.firstName, data.lastName].filter(Boolean).join(" ") || data.name || "";
      const lines = [
        name && "Name: " + name,
        data.email && "Email: " + data.email,
        data.phone && "Phone: " + data.phone,
        data.company && "Company: " + data.company,
        data.service && "Service: " + data.service,
        data.budget && "Budget: " + data.budget,
        data.startDate && "Preferred start: " + data.startDate,
        data.message && "Project details: " + data.message,
      ].filter(Boolean);

      const subject = encodeURIComponent("New inquiry from " + (name || "your website"));
      const body = encodeURIComponent(lines.join("\n"));
      const mailto = "mailto:" + contactEmail + "?subject=" + subject + "&body=" + body;

      window.location.href = mailto;

      form.innerHTML =
        '<div class="text-center py-6">' +
        '<div class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-full bg-accent/10">' +
        '<svg class="h-6 w-6 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">' +
        '<path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />' +
        "</svg></div>" +
        '<p class="text-lg font-bold text-text">Ready to send</p>' +
        '<p class="mt-1 text-sm text-text-muted">Your email app should open with this inquiry addressed to ' + contactEmail + '. If it does not, <a class="text-primary font-semibold underline" href="' + mailto + '">click here to email me</a>.</p>' +
        "</div>";
    });
  })();
</script>
