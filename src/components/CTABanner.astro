---
import { siteConfig } from "../config/siteConfig";

interface Props {
  title?: string;
  subtitle?: string;
}

const {
  title = "Ready to Get Started?",
  subtitle = `Tell ${siteConfig.businessName} about your project and let's build something that delivers results.`,
} = Astro.props;
---

<section class="bg-primary">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <div class="flex flex-col lg:flex-row items-center justify-between gap-8 text-center lg:text-left">
      <div>
        <h2 class="text-2xl sm:text-3xl font-bold text-white">{title}</h2>
        <p class="mt-2 text-lg text-white/80">{subtitle}</p>
      </div>
      <div class="flex flex-col sm:flex-row gap-4 shrink-0">
        <a
          href="/contact/"
          class="inline-flex items-center justify-center rounded-lg bg-white px-6 py-3.5 text-base font-semibold text-primary shadow-lg hover:bg-gray-100 transition-colors"
        >
          Start a Project
        </a>
        <a
          href={`tel:${siteConfig.phone.replace(/\D/g, "")}`}
          class="inline-flex items-center justify-center rounded-lg border-2 border-white/30 px-6 py-3.5 text-base font-semibold text-white hover:bg-white/10 transition-colors"
        >
          <svg class="mr-2 h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          {siteConfig.phone}
        </a>
      </div>
    </div>
  </div>
</section>
