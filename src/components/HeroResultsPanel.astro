---
/*
  Floating results dashboard for heroes.
  CSS/UI cards only (no AI image). Brand: navy + sky cyan.
  variant: "local" (homepage) | "remote" (international hire / onlinejobs.ph)
*/
import Icon from "./Icon.astro";

interface Props {
  tone?: "onDark" | "onLight";
  variant?: "local" | "remote";
}

const { tone = "onDark", variant = "local" } = Astro.props;
const isDark = tone === "onDark";
const isRemote = variant === "remote";

const floatTop = isRemote
  ? {
      eyebrow: "Delivery",
      text: "Shipped on time across 3 time zones",
    }
  : {
      eyebrow: "Map Pack",
      text: "Ranking up +12 spots in 60 days",
    };

const metrics = isRemote
  ? [
      { label: "Sites", value: "35+", delta: "Shipped" },
      { label: "Reply", value: "<24h", delta: "Typical" },
      { label: "Years", value: "3+", delta: "Building" },
    ]
  : [
      { label: "Calls", value: "218", delta: "+44%" },
      { label: "Leads", value: "87", delta: "+62%" },
      { label: "Bookings", value: "41", delta: "+38%" },
    ];

const chartTitle = isRemote ? "Client conversion · after redesign" : "Local search · near me";
const chartId = isRemote ? "heroChartFillRemote" : "heroChartFillLocal";

const bottomLeft = isRemote
  ? { label: "English", value: "Fluent", sub: "Client-ready" }
  : { label: "SEO score", value: "98", sub: "/100" };

const bottomRight = isRemote
  ? { label: "Availability", value: "Overlap", note: "US / AU / EU hours" }
  : { label: "Mobile speed", value: "Fast", note: null };

const floatBottom = isRemote
  ? {
      eyebrow: "New message",
      text: "Project brief answered · 18m ago",
    }
  : {
      eyebrow: "New lead",
      text: "Quote requested · 2m ago",
    };

const panelTitle = isRemote ? "Remote hire dashboard" : "Results dashboard";
const panelSub = isRemote ? "What you get when you hire me" : "What a converting site drives";
---

<div
  class:list={[
    "hero-results relative mx-auto w-full max-w-md lg:max-w-none",
    isDark ? "animate-float" : "animate-float",
  ]}
>
  <div
    class:list={[
      "absolute -inset-3 sm:-inset-5 rounded-[2rem] blur-2xl pointer-events-none",
      isDark ? "bg-secondary/20" : "bg-secondary/25",
    ]}
    aria-hidden="true"
  ></div>

  <div class="hero-results-float hero-results-float-a absolute -left-1 sm:-left-4 top-3 z-20 max-w-[13.5rem] rounded-2xl border border-border bg-white px-3.5 py-3 shadow-xl shadow-black/10">
    <div class="flex items-start gap-2.5">
      <span class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-xl bg-emerald-500/15 text-emerald-600">
        <Icon name="zap" class="h-4 w-4" />
      </span>
      <div>
        <p class="text-[11px] font-bold uppercase tracking-wide text-emerald-600">{floatTop.eyebrow}</p>
        <p class="mt-0.5 text-xs font-semibold text-text leading-snug">{floatTop.text}</p>
      </div>
    </div>
  </div>

  <div class="relative z-10 rounded-2xl sm:rounded-3xl border border-white/80 bg-white p-4 sm:p-5 shadow-2xl shadow-black/25">
    <div class="flex items-center justify-between gap-3 mb-4">
      <div>
        <p class="font-heading text-sm font-bold text-text">{panelTitle}</p>
        <p class="text-[11px] text-text-muted">{panelSub}</p>
      </div>
      <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-500/10 px-2.5 py-1 text-[11px] font-bold text-emerald-700">
        <span class="h-1.5 w-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
        {isRemote ? "Available" : "Live"}
      </span>
    </div>

    <div class="grid grid-cols-3 gap-2 sm:gap-2.5 mb-4">
      {metrics.map((m) => (
        <div class="rounded-xl border border-border bg-surface-alt px-2.5 py-2.5 sm:px-3">
          <p class="text-[10px] font-bold uppercase tracking-wider text-text-muted">{m.label}</p>
          <p class="mt-0.5 font-heading text-lg sm:text-xl font-extrabold text-text tabular-nums">{m.value}</p>
          <p class="text-[11px] font-bold text-emerald-600">{m.delta}</p>
        </div>
      ))}
    </div>

    <div class="rounded-xl border border-border bg-surface-alt p-3 sm:p-3.5 mb-4">
      <div class="flex items-center justify-between gap-2 mb-2">
        <p class="text-[11px] font-bold text-text">{chartTitle}</p>
        <p class="text-[10px] font-semibold text-text-muted">90 days</p>
      </div>
      <svg viewBox="0 0 320 100" class="w-full h-[72px] sm:h-[84px]" aria-hidden="true">
        <defs>
          <linearGradient id={chartId} x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#38BDF8" stop-opacity="0.35" />
            <stop offset="100%" stop-color="#38BDF8" stop-opacity="0" />
          </linearGradient>
        </defs>
        <path
          d="M0 82 C40 78, 55 70, 80 62 C110 50, 130 55, 160 40 C190 26, 220 30, 250 18 C280 8, 300 12, 320 8 L320 100 L0 100 Z"
          fill={`url(#${chartId})`}
        />
        <path
          d="M0 82 C40 78, 55 70, 80 62 C110 50, 130 55, 160 40 C190 26, 220 30, 250 18 C280 8, 300 12, 320 8"
          fill="none"
          stroke="#0B1220"
          stroke-width="2.5"
          stroke-linecap="round"
        />
        <circle cx="320" cy="8" r="4" fill="#38BDF8" stroke="#fff" stroke-width="2" />
      </svg>
    </div>

    <div class="grid grid-cols-2 gap-2 sm:gap-3">
      <div class="rounded-xl border border-border px-3 py-2.5">
        <p class="text-[10px] font-bold uppercase tracking-wider text-text-muted">{bottomLeft.label}</p>
        {isRemote ? (
          <p class="mt-0.5 font-heading text-base font-extrabold text-text">{bottomLeft.value}</p>
        ) : (
          <p class="mt-0.5 font-heading text-base font-extrabold text-text">
            {bottomLeft.value}<span class="text-text-muted font-semibold text-sm">{bottomLeft.sub}</span>
          </p>
        )}
        {isRemote && <p class="text-[11px] font-semibold text-emerald-600">{bottomLeft.sub}</p>}
      </div>
      <div class="rounded-xl border border-border px-3 py-2.5">
        <p class="text-[10px] font-bold uppercase tracking-wider text-text-muted">{bottomRight.label}</p>
        {isRemote ? (
          <>
            <p class="mt-0.5 font-heading text-base font-extrabold text-text">{bottomRight.value}</p>
            <p class="text-[11px] font-semibold text-emerald-600">{bottomRight.note}</p>
          </>
        ) : (
          <>
            <div class="mt-1.5 h-2 rounded-full bg-surface-alt overflow-hidden">
              <div class="h-full w-[92%] rounded-full bg-gradient-to-r from-secondary to-emerald-400"></div>
            </div>
            <p class="mt-1 text-[11px] font-bold text-emerald-600">Fast</p>
          </>
        )}
      </div>
    </div>
  </div>

  <div class="hero-results-float hero-results-float-b absolute -right-1 sm:-right-3 bottom-6 z-20 max-w-[14.5rem] rounded-2xl bg-primary px-3.5 py-3 shadow-xl shadow-primary/40 ring-1 ring-white/10">
    <div class="flex items-start gap-2.5">
      <span class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-xl bg-secondary/20 text-secondary">
        <Icon name={isRemote ? "check-circle" : "phone"} class="h-4 w-4" />
      </span>
      <div>
        <p class="text-[11px] font-bold uppercase tracking-wide text-secondary">{floatBottom.eyebrow}</p>
        <p class="mt-0.5 text-xs font-semibold text-white leading-snug">{floatBottom.text}</p>
      </div>
    </div>
  </div>
</div>

<style>
  .hero-results-float-a {
    animation: hero-float-a 5.5s ease-in-out infinite;
  }
  .hero-results-float-b {
    animation: hero-float-b 6.5s ease-in-out infinite;
  }
  @keyframes hero-float-a {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }
  @keyframes hero-float-b {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(7px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-results-float-a,
    .hero-results-float-b {
      animation: none;
    }
  }
</style>
