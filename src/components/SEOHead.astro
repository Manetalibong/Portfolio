---
import { siteConfig } from "../config/siteConfig";
import { withBase } from "../config/paths";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
  type?: "website" | "article";
  noindex?: boolean;
}

const {
  title = `${siteConfig.businessName} | ${siteConfig.tagline}`,
  description = `${siteConfig.businessName} provides professional web design, development, SEO, and digital marketing services. Call ${siteConfig.phone} to start your project.`,
  image = siteConfig.logo || "/favicon.svg",
  type = "website",
  noindex = false,
} = Astro.props;

/** Canonical: site + path, trailing slash, no query/hash (UTMs must not create duplicate canonicals). */
function buildCanonical(override?: string): string {
  if (override) {
    const u = new URL(override);
    let path = u.pathname;
    if (!path.endsWith("/")) path += "/";
    return `${u.origin}${path}`;
  }

  const origin = (Astro.site?.origin || siteConfig.domain).replace(/\/$/, "");
  let path = Astro.url.pathname;
  if (!path.endsWith("/")) path += "/";
  return `${origin}${path}`;
}

const canonicalUrl = buildCanonical(Astro.props.canonicalUrl);

const origin = (Astro.site?.origin || siteConfig.domain).replace(/\/$/, "");
const fullImageUrl = image.startsWith("http")
  ? image
  : new URL(withBase(image), `${origin}/`).toString();
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="google-site-verification" content="g6uIxNsvNFPpKIgD4BoKKZmfvEO6CJdJX4RJur0lSoo" />
<link rel="icon" href={withBase("/favicon.ico")} sizes="any" />
<link rel="icon" type="image/png" sizes="32x32" href={withBase("/favicon-32x32.png")} />
<link rel="apple-touch-icon" sizes="180x180" href={withBase("/apple-touch-icon.png")} />
<link rel="sitemap" href={withBase("/sitemap.xml")} />
<meta name="generator" content={Astro.generator} />

<meta
  name="robots"
  content={noindex
    ? "noindex, nofollow"
    : "index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"}
/>

<title>{title}</title>
<meta name="description" content={description} />
{!noindex && <link rel="canonical" href={canonicalUrl} />}

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={fullImageUrl} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:site_name" content={siteConfig.businessName} />
<meta property="og:locale" content="en_US" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />

<!-- Geo / Local -->
<meta name="geo.region" content="PH" />
<meta name="geo.placename" content={siteConfig.address.city} />

{siteConfig.gtmId && (
  <script
    set:html={`(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','${siteConfig.gtmId}');`}
  />
)}
