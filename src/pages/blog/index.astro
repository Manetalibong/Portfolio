---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { siteConfig } from "../../config/siteConfig";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<BaseLayout
  title={`Blog | ${siteConfig.businessName}`}
  description={`Tips, guides, and news from ${siteConfig.businessName}. Stay informed about home maintenance, industry trends, and more.`}
>
  <section class="bg-primary py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl sm:text-5xl font-bold text-white">Blog</h1>
      <p class="mt-4 text-lg text-white/80 max-w-2xl mx-auto">
        Tips, guides, and expert advice from our team.
      </p>
    </div>
  </section>

  <section class="py-16 sm:py-20 bg-surface">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      {posts.length === 0 ? (
        <p class="text-center text-text-muted text-lg">Blog posts coming soon!</p>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {posts.map((post) => (
            <a
              href={`/blog/${post.id}`}
              class="group block rounded-xl border border-border bg-surface overflow-hidden shadow-sm hover:shadow-md transition-shadow"
            >
              {post.data.image && (
                <div class="overflow-hidden aspect-video">
                  <img
                    src={post.data.image}
                    alt={post.data.title}
                    class="h-full w-full object-cover group-hover:scale-105 transition-transform duration-300"
                    loading="lazy"
                  />
                </div>
              )}
              <div class="p-6">
                <div class="flex items-center gap-3 text-sm text-text-muted mb-3">
                  <time datetime={post.data.date.toISOString().split("T")[0]}>
                    {post.data.date.toLocaleDateString("en-US", {
                      year: "numeric",
                      month: "long",
                      day: "numeric",
                    })}
                  </time>
                  {post.data.tags.length > 0 && (
                    <>
                      <span class="text-border">|</span>
                      <span>{post.data.tags[0]}</span>
                    </>
                  )}
                </div>
                <h2 class="text-lg font-semibold text-text group-hover:text-primary transition-colors">
                  {post.data.title}
                </h2>
                <p class="mt-2 text-sm text-text-muted line-clamp-3">{post.data.description}</p>
                <span class="mt-4 inline-flex items-center text-sm font-medium text-primary">
                  Read more
                  <svg class="ml-1 h-4 w-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                  </svg>
                </span>
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>
