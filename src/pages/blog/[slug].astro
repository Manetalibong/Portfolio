---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import CTABanner from "../../components/CTABanner.astro";
import { siteConfig } from "../../config/siteConfig";
import { withBase } from "../../config/paths";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, metaTitle, metaDescription, image, author, date, tags } = post.data;

const formattedDate = date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<BaseLayout
  title={metaTitle || `${title} | ${siteConfig.businessName}`}
  description={metaDescription || description}
  image={image}
  type="article"
  schema="Article"
  articleTitle={title}
  articleDate={date.toISOString()}
  articleAuthor={author}
>
  <PageHeader
    title={title}
    subtitle={`${author} · ${formattedDate}`}
    backgroundImage={image}
    breadcrumbs={[
      { label: "Home", href: "/" },
      { label: "Blog", href: "/blog/" },
      { label: title },
    ]}
  />

  <article class="py-16 sm:py-20 bg-surface">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      {image && (
        <img
          src={withBase(image)}
          alt={title}
          class="w-full rounded-2xl mb-10 aspect-video object-cover object-center"
          loading="eager"
          fetchpriority="high"
        />
      )}

      <div class="prose prose-lg max-w-none prose-headings:font-heading prose-headings:text-text prose-p:text-text-muted prose-li:text-text-muted prose-a:text-primary prose-strong:text-text">
        <Content />
      </div>

      {tags.length > 0 && (
        <div class="mt-10 pt-6 border-t border-border">
          <div class="flex flex-wrap items-center gap-2">
            <span class="text-sm font-medium text-text-muted">Topics:</span>
            {tags.map((tag) => (
              <span class="inline-block rounded-full bg-primary/10 px-3 py-1 text-xs font-medium text-primary">
                {tag}
              </span>
            ))}
          </div>
        </div>
      )}

      <div class="mt-8">
        <a
          href={withBase("/blog/")}
          class="inline-flex items-center text-sm font-semibold text-primary hover:text-primary-light transition-colors"
        >
          <svg class="mr-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
          </svg>
          Back to all posts
        </a>
      </div>
    </div>
  </article>

  <CTABanner
    title="Need a website in Butuan City?"
    subtitle="Tell me about your business and I will map a clear next step for your site and local SEO."
  />
</BaseLayout>
