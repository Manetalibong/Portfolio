---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import ServiceCard from "../../components/ServiceCard.astro";
import CTABanner from "../../components/CTABanner.astro";
import { siteConfig } from "../../config/siteConfig";
import { getCollection } from "astro:content";

const services = (await getCollection("services")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout
  title={`Services | ${siteConfig.businessName}`}
  description="Website design, WordPress development, landing pages, SEO, graphic design, digital marketing, and website maintenance from Mane Talibong."
>
  <PageHeader
    title="Services"
    subtitle="High-converting websites, design, SEO, and digital marketing built around your business goals."
    breadcrumbs={[
      { label: "Home", href: "/" },
      { label: "Services" },
    ]}
  />

  <section class="py-16 sm:py-20 bg-surface">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mb-12">
        <p class="text-sm font-bold uppercase tracking-wider text-secondary mb-3">What I Offer</p>
        <h2 class="font-heading text-3xl sm:text-4xl font-extrabold text-text">
          Built to Attract Visitors and Convert Them
        </h2>
        <p class="mt-4 text-text-muted leading-relaxed">
          I combine development, design, SEO, and marketing so your website looks professional and works as a sales tool.
        </p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {services.map((service) => (
          <ServiceCard
            title={service.data.title}
            description={service.data.description}
            slug={service.id}
            icon={service.data.icon}
            image={service.data.image}
          />
        ))}
      </div>
    </div>
  </section>

  <CTABanner
    title="Have a project in mind?"
    subtitle="Tell me about your website, redesign, branding, or SEO goal and we'll map the next step."
  />
</BaseLayout>
