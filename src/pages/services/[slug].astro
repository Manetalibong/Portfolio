---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import CTABanner from "../../components/CTABanner.astro";
import Icon from "../../components/Icon.astro";
import { siteConfig } from "../../config/siteConfig";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const services = await getCollection("services");
  return services.map((service) => ({
    params: { slug: service.id },
    props: { service },
  }));
}

const { service } = Astro.props;
const { Content } = await render(service);
const { title, description, metaTitle, metaDescription, image, features, icon } = service.data;

const relatedServices = (await getCollection("services"))
  .filter((item) => item.id !== service.id)
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title={metaTitle || `${title} | ${siteConfig.businessName}`}
  description={metaDescription || description}
  image={image}
  schema="Service"
  serviceName={title}
  serviceDescription={description}
>
  <PageHeader
    title={title}
    subtitle={description}
    breadcrumbs={[
      { label: "Home", href: "/" },
      { label: "Services", href: "/services/" },
      { label: title },
    ]}
  />

  <section class="py-16 sm:py-20 bg-surface">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <div class="lg:col-span-2">
          {image && (
            <img
              src={image}
              alt={title}
              class="w-full rounded-2xl mb-8 aspect-video object-cover"
              loading="lazy"
            />
          )}
          <div class="prose prose-lg max-w-none prose-headings:font-heading prose-headings:text-text prose-p:text-text-muted prose-li:text-text-muted prose-strong:text-text prose-a:text-primary">
            <Content />
          </div>
        </div>

        <aside class="lg:col-span-1">
          <div class="lg:sticky lg:top-28 space-y-6">
            {features.length > 0 && (
              <div class="rounded-2xl border border-border bg-surface-alt p-6">
                <h2 class="font-heading text-lg font-bold text-text mb-4">What's Included</h2>
                <ul class="space-y-3">
                  {features.map((feature) => (
                    <li class="flex items-start gap-3">
                      <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-secondary/15">
                        <Icon name="check" class="h-3 w-3 text-primary" />
                      </span>
                      <span class="text-sm text-text-muted">{feature}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            <div class="rounded-2xl bg-primary p-6 text-white">
              {icon && (
                <div class="mb-4 flex h-11 w-11 items-center justify-center rounded-xl bg-white/10">
                  <Icon name={icon} class="h-5 w-5 text-secondary" />
                </div>
              )}
              <h2 class="font-heading text-lg font-bold mb-2">Need this service?</h2>
              <p class="text-sm text-white/75 mb-4">
                Tell me about your project and I'll follow up with a clear next step.
              </p>
              <a
                href="/contact/"
                class="block w-full text-center rounded-lg bg-secondary px-4 py-2.5 text-sm font-semibold text-primary hover:bg-secondary-light transition-colors"
              >
                Start a Project
              </a>
              <a
                href={`mailto:${siteConfig.email}`}
                class="block w-full text-center mt-3 rounded-lg border border-white/25 px-4 py-2.5 text-sm font-semibold text-white hover:bg-white/10 transition-colors"
              >
                Email Me
              </a>
            </div>

            <div class="rounded-2xl border border-border bg-surface-alt p-6">
              <h2 class="font-heading text-lg font-bold text-text mb-4">Other Services</h2>
              <ul class="space-y-2">
                {relatedServices.map((item) => (
                  <li>
                    <a
                      href={`/services/${item.id}/`}
                      class="flex items-center justify-between gap-3 rounded-lg px-2 py-2 text-sm font-medium text-text hover:bg-surface hover:text-primary transition-colors"
                    >
                      <span>{item.data.title}</span>
                      <Icon name="arrow-right" class="h-4 w-4 shrink-0 text-text-muted" />
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <CTABanner
    title="Ready to grow your online presence?"
    subtitle="Let's build a website and marketing setup that helps you get more customers."
  />
</BaseLayout>
