---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CTABanner from "../../components/CTABanner.astro";
import { siteConfig } from "../../config/siteConfig";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const services = await getCollection("services");
  return services.map((service) => ({
    params: { slug: service.id },
    props: { service },
  }));
}

const { service } = Astro.props;
const { Content } = await render(service);
const { title, description, metaTitle, metaDescription, image, features } = service.data;
---

<BaseLayout
  title={metaTitle || `${title} | ${siteConfig.businessName}`}
  description={metaDescription || description}
  image={image}
  schema="Service"
  serviceName={title}
  serviceDescription={description}
>
  <!-- Page Header -->
  <section class="bg-primary py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <nav class="mb-4 text-sm text-white/60">
        <a href="/" class="hover:text-white transition-colors">Home</a>
        <span class="mx-2">/</span>
        <a href="/services" class="hover:text-white transition-colors">Services</a>
        <span class="mx-2">/</span>
        <span class="text-white">{title}</span>
      </nav>
      <h1 class="text-4xl sm:text-5xl font-bold text-white">{title}</h1>
      <p class="mt-4 text-lg text-white/80 max-w-3xl">{description}</p>
    </div>
  </section>

  <section class="py-16 sm:py-20 bg-surface">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <!-- Content -->
        <div class="lg:col-span-2">
          {image && (
            <img
              src={image}
              alt={title}
              class="w-full rounded-xl mb-8 aspect-video object-cover"
              loading="lazy"
            />
          )}
          <div class="prose prose-lg max-w-none prose-headings:text-text prose-p:text-text-muted prose-a:text-primary">
            <Content />
          </div>
        </div>

        <!-- Sidebar -->
        <aside class="lg:col-span-1">
          {features.length > 0 && (
            <div class="rounded-xl border border-border bg-surface-alt p-6 mb-6">
              <h3 class="text-lg font-semibold text-text mb-4">What's Included</h3>
              <ul class="space-y-3">
                {features.map((feature) => (
                  <li class="flex items-start gap-3">
                    <svg class="h-5 w-5 text-accent shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                    <span class="text-sm text-text-muted">{feature}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}

          <div class="rounded-xl bg-primary p-6 text-white">
            <h3 class="text-lg font-semibold mb-2">Need This Service?</h3>
            <p class="text-sm text-white/80 mb-4">
              Contact us today for a free estimate. We offer same-day service for emergencies.
            </p>
            <a
              href="/contact"
              class="block w-full text-center rounded-lg bg-white px-4 py-2.5 text-sm font-semibold text-primary hover:bg-gray-100 transition-colors"
            >
              Get a Free Estimate
            </a>
            <a
              href={`tel:${siteConfig.phone.replace(/\D/g, "")}`}
              class="block w-full text-center mt-3 rounded-lg border border-white/30 px-4 py-2.5 text-sm font-semibold text-white hover:bg-white/10 transition-colors"
            >
              Call {siteConfig.phone}
            </a>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <CTABanner />
</BaseLayout>
