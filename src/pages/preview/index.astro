---
import PreviewLayout from "../../layouts/PreviewLayout.astro";

const sections = [
  {
    title: "Headers",
    href: "/preview/headers",
    count: 6,
    desc: "HeaderSimple, HeaderTwoTier, HeaderThreeTier, HeaderTopBar, HeaderContainedDark, HeaderContainedLight",
  },
  {
    title: "Heroes",
    href: "/preview/heroes",
    count: 6,
    desc: "HeroCentered, HeroSplit, HeroSplitDark, HeroWithStats, HeroWithForm, HeroBoldLeft",
  },
  {
    title: "Features",
    href: "/preview/features",
    count: 15,
    desc: "FeaturesGrid, FeaturesAlternating, FeaturesWithImage, FeaturesLinkedCards, ServicesShowcase, ServicesImageStrip, ServicesGridDark, ServicesGridBold, ServicesWithPhoto, ServicesHoverGrid, ServicesOverlayCards, ServicesEditorial, ServicesPopular, ServicesCenterImage, PricingTable",
  },
  {
    title: "Content",
    href: "/preview/content",
    count: 16,
    desc: "ContentSplit, ContentFullWidth, ContentBeforeAfter, ContentShowcase, ContentMosaicStats, ContentTiltedImage, ContentFeatured, WhyChooseUs, AboutDecorative, WhyChooseUsCenter, ProcessSteps, ProcessStepsCards, ServiceAreaMap, ServiceAreaMapFull, CompanyIntro, ValuesPillars",
  },
  {
    title: "Testimonials",
    href: "/preview/testimonials",
    count: 4,
    desc: "TestimonialsGrid, TestimonialsSimple, TestimonialsFeatured, TestimonialsColorCards",
  },
  {
    title: "Stats",
    href: "/preview/stats",
    count: 2,
    desc: "StatsBar, StatsGrid",
  },
  {
    title: "CTA",
    href: "/preview/cta",
    count: 4,
    desc: "CTABanner, CTAWithForm, CTASplit, CTABold",
  },
  {
    title: "FAQ",
    href: "/preview/faq",
    count: 7,
    desc: "FAQAccordion, FAQTwoColumn, FAQWithImage, FAQSplitImage, FAQDecorated, FAQImageRight, FAQGallery",
  },
  {
    title: "Gallery",
    href: "/preview/gallery",
    count: 3,
    desc: "GalleryGrid, GalleryBeforeAfter, GalleryMarquee",
  },
  {
    title: "Dividers & Patterns",
    href: "/preview/dividers",
    count: 16,
    desc: "6 divider types + 10 background patterns (Hero Patterns style)",
  },
  {
    title: "Silhouettes",
    href: "/preview/silhouettes",
    count: 6,
    desc: "trees, cityscape, roofline, tools, waves, mountains",
  },
  {
    title: "Icons",
    href: "/preview/icons",
    count: 30,
    desc: "SVG icon set — wrench, shield, star, phone, home, and more",
  },
  {
    title: "Components",
    href: "/preview/components",
    count: 3,
    desc: "PageHeader, LeadForm, GoogleMap",
  },
];
---

<PreviewLayout title="All Sections">
  <div class="mx-auto max-w-5xl px-4 py-10">
    <h1 class="text-3xl font-bold text-gray-900 mb-2">Section Library</h1>
    <p class="text-gray-500 mb-8">Browse every available section variant. Click a category to see live previews.</p>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {sections.map((s) => (
        <a
          href={s.href}
          class="block rounded-xl bg-white p-6 shadow-sm border border-gray-200 hover:shadow-md hover:border-primary/30 transition-all group"
        >
          <div class="flex items-center justify-between mb-2">
            <h2 class="text-lg font-bold text-gray-900 group-hover:text-primary transition-colors">{s.title}</h2>
            <span class="text-xs font-mono bg-gray-100 text-gray-500 px-2 py-0.5 rounded-full">{s.count}</span>
          </div>
          <p class="text-sm text-gray-500">{s.desc}</p>
        </a>
      ))}
    </div>
  </div>
</PreviewLayout>
