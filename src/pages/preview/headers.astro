---
import PreviewLayout from "../../layouts/PreviewLayout.astro";
import HeaderSimple from "../../../_section-library/headers/HeaderSimple.astro";
import HeaderTwoTier from "../../../_section-library/headers/HeaderTwoTier.astro";
import HeaderThreeTier from "../../../_section-library/headers/HeaderThreeTier.astro";
import HeaderTopBar from "../../../_section-library/headers/HeaderTopBar.astro";
import HeaderContainedDark from "../../../_section-library/headers/HeaderContainedDark.astro";
import HeaderContainedLight from "../../../_section-library/headers/HeaderContainedLight.astro";

const img = (n: string) => `/images/Preview/${n}`;
---

<PreviewLayout title="Headers">
  <div class="mx-auto max-w-7xl px-4 py-10 space-y-16">
    <!-- HeaderSimple -->
    <section>
      <div class="mb-4">
        <span class="text-xs font-mono bg-gray-200 text-gray-600 px-2 py-1 rounded">_section-library/headers/HeaderSimple.astro</span>
        <h2 class="text-2xl font-bold text-gray-900 mt-2">HeaderSimple</h2>
        <p class="text-gray-500 text-sm">Single-row sticky header. Logo, nav links, phone CTA.</p>
      </div>
      <div class="rounded-xl overflow-hidden border border-gray-300 shadow-sm relative">
        <div class="[&>header]:!sticky [&>header]:!relative">
          <HeaderSimple />
        </div>
      </div>
    </section>

    <!-- HeaderTwoTier -->
    <section>
      <div class="mb-4">
        <span class="text-xs font-mono bg-gray-200 text-gray-600 px-2 py-1 rounded">_section-library/headers/HeaderTwoTier.astro</span>
        <h2 class="text-2xl font-bold text-gray-900 mt-2">HeaderTwoTier</h2>
        <p class="text-gray-500 text-sm">Logo/phone row + primary-colored navigation bar.</p>
      </div>
      <div class="rounded-xl overflow-hidden border border-gray-300 shadow-sm relative">
        <div class="[&>header]:!sticky [&>header]:!relative">
          <HeaderTwoTier />
        </div>
      </div>
    </section>

    <!-- HeaderThreeTier -->
    <section>
      <div class="mb-4">
        <span class="text-xs font-mono bg-gray-200 text-gray-600 px-2 py-1 rounded">_section-library/headers/HeaderThreeTier.astro</span>
        <h2 class="text-2xl font-bold text-gray-900 mt-2">HeaderThreeTier</h2>
        <p class="text-gray-500 text-sm">Top utility bar + logo/phone row + nav bar. Pass topBarLinks for extra utility links.</p>
      </div>
      <div class="rounded-xl overflow-hidden border border-gray-300 shadow-sm relative">
        <div class="[&>header]:!sticky [&>header]:!relative">
          <HeaderThreeTier topBarLinks={[
            { label: "Financing", href: "/financing" },
            { label: "Blog", href: "/blog" },
            { label: "Reviews", href: "/reviews" },
          ]} />
        </div>
      </div>
    </section>
    <!-- HeaderTopBar -->
    <section>
      <div class="mb-4">
        <span class="text-xs font-mono bg-gray-200 text-gray-600 px-2 py-1 rounded">_section-library/headers/HeaderTopBar.astro</span>
        <h2 class="text-2xl font-bold text-gray-900 mt-2">HeaderTopBar</h2>
        <p class="text-gray-500 text-sm">Slim utility bar (phone, hours, socials) on top, clean white nav bar below with logo left, nav + CTA right. Utility bar hidden on mobile.</p>
      </div>
      <div class="rounded-xl overflow-hidden border border-gray-300 shadow-sm relative">
        <div class="[&>header]:!sticky [&>header]:!relative">
          <HeaderTopBar />
        </div>
      </div>
    </section>

    <!-- HeaderContainedDark -->
    <section>
      <div class="mb-4">
        <span class="text-xs font-mono bg-gray-200 text-gray-600 px-2 py-1 rounded">_section-library/headers/HeaderContainedDark.astro</span>
        <h2 class="text-2xl font-bold text-gray-900 mt-2">HeaderContainedDark</h2>
        <p class="text-gray-500 text-sm">Floating pill navbar (dark). Sits on top of hero imagery. Logo inverted to white. Ghost CTA button.</p>
      </div>
      <div class="rounded-xl overflow-hidden border border-gray-300 shadow-sm relative">
        <div class="relative h-80 overflow-hidden">
          <img src={img("hvac sample (2).jpg")} alt="Hero background" class="absolute inset-0 w-full h-full object-cover" />
          <div class="[&>header]:!fixed [&>header]:!relative [&>header]:!px-4 [&>header]:!pt-4">
            <HeaderContainedDark />
          </div>
          <div class="absolute inset-0 flex items-center justify-center pt-20">
            <p class="text-white text-2xl font-bold drop-shadow-lg">Hero content goes here</p>
          </div>
        </div>
      </div>
    </section>

    <!-- HeaderContainedLight -->
    <section>
      <div class="mb-4">
        <span class="text-xs font-mono bg-gray-200 text-gray-600 px-2 py-1 rounded">_section-library/headers/HeaderContainedLight.astro</span>
        <h2 class="text-2xl font-bold text-gray-900 mt-2">HeaderContainedLight</h2>
        <p class="text-gray-500 text-sm">Floating pill navbar (light/white). Great over dark hero backgrounds for contrast. Solid primary CTA.</p>
      </div>
      <div class="rounded-xl overflow-hidden border border-gray-300 shadow-sm relative">
        <div class="relative h-80 overflow-hidden">
          <img src={img("hvac sample (3).jpg")} alt="Hero background" class="absolute inset-0 w-full h-full object-cover" />
          <div class="absolute inset-0 bg-gray-900/40"></div>
          <div class="[&>header]:!fixed [&>header]:!relative [&>header]:!px-4 [&>header]:!pt-4">
            <HeaderContainedLight />
          </div>
          <div class="absolute inset-0 flex items-center justify-center pt-20">
            <p class="text-white text-2xl font-bold drop-shadow-lg">Hero content goes here</p>
          </div>
        </div>
      </div>
    </section>
  </div>
</PreviewLayout>
