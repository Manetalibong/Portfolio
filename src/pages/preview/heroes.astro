---
import PreviewLayout from "../../layouts/PreviewLayout.astro";
import HeroCentered from "../../../_section-library/heroes/HeroCentered.astro";
import HeroSplit from "../../../_section-library/heroes/HeroSplit.astro";
import HeroWithStats from "../../../_section-library/heroes/HeroWithStats.astro";
import HeroWithForm from "../../../_section-library/heroes/HeroWithForm.astro";
import HeroSplitDark from "../../../_section-library/heroes/HeroSplitDark.astro";
import HeroBoldLeft from "../../../_section-library/heroes/HeroBoldLeft.astro";

const img = (n: string) => `/images/Preview/${n}`;
---

<PreviewLayout title="Heroes">
  <div class="space-y-16 py-10">
    <!-- HeroCentered -->
    <div>
      <div class="mx-auto max-w-7xl px-4 mb-4">
        <span class="text-xs font-mono bg-gray-200 text-gray-600 px-2 py-1 rounded">_section-library/heroes/HeroCentered.astro</span>
        <h2 class="text-2xl font-bold text-gray-900 mt-2">HeroCentered</h2>
        <p class="text-gray-500 text-sm">Full-width background image, centered headline + CTAs.</p>
      </div>
      <HeroCentered backgroundImage={img("hvac sample.jpg")} />
    </div>

    <!-- HeroSplit -->
    <div>
      <div class="mx-auto max-w-7xl px-4 mb-4">
        <span class="text-xs font-mono bg-gray-200 text-gray-600 px-2 py-1 rounded">_section-library/heroes/HeroSplit.astro</span>
        <h2 class="text-2xl font-bold text-gray-900 mt-2">HeroSplit</h2>
        <p class="text-gray-500 text-sm">Two-column: text left, image right.</p>
      </div>
      <HeroSplit imageSrc={img("hvac sample (2).jpg")} />
    </div>

    <!-- HeroWithStats -->
    <div>
      <div class="mx-auto max-w-7xl px-4 mb-4">
        <span class="text-xs font-mono bg-gray-200 text-gray-600 px-2 py-1 rounded">_section-library/heroes/HeroWithStats.astro</span>
        <h2 class="text-2xl font-bold text-gray-900 mt-2">HeroWithStats</h2>
        <p class="text-gray-500 text-sm">Full-width hero with a stat counter bar along the bottom.</p>
      </div>
      <HeroWithStats backgroundImage={img("hvac sample (1).jpg")} />
    </div>

    <!-- HeroWithForm -->
    <div>
      <div class="mx-auto max-w-7xl px-4 mb-4">
        <span class="text-xs font-mono bg-gray-200 text-gray-600 px-2 py-1 rounded">_section-library/heroes/HeroWithForm.astro</span>
        <h2 class="text-2xl font-bold text-gray-900 mt-2">HeroWithForm</h2>
        <p class="text-gray-500 text-sm">Background image, text + bullets left, lead form right.</p>
      </div>
      <HeroWithForm backgroundImage={img("hvac sample (3).jpg")} />
    </div>

    <!-- HeroSplitDark -->
    <div>
      <div class="mx-auto max-w-7xl px-4 mb-4">
        <span class="text-xs font-mono bg-gray-200 text-gray-600 px-2 py-1 rounded">_section-library/heroes/HeroSplitDark.astro</span>
        <h2 class="text-2xl font-bold text-gray-900 mt-2">HeroSplitDark</h2>
        <p class="text-gray-500 text-sm">Image left, dark panel right with headline + CTA. Values bar underneath.</p>
      </div>
      <HeroSplitDark imageSrc={img("hvac sample (15).jpg")} />
    </div>

    <!-- HeroBoldLeft -->
    <div>
      <div class="mx-auto max-w-7xl px-4 mb-4">
        <span class="text-xs font-mono bg-gray-200 text-gray-600 px-2 py-1 rounded">_section-library/heroes/HeroBoldLeft.astro</span>
        <h2 class="text-2xl font-bold text-gray-900 mt-2">HeroBoldLeft</h2>
        <p class="text-gray-500 text-sm">Full-width bg image, location badge, two-tone headline, dual CTAs, trust bar at bottom.</p>
      </div>
      <HeroBoldLeft backgroundImage={img("hvac sample (1).jpg")} />
    </div>
  </div>
</PreviewLayout>
