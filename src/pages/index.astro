---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import ServiceCard from "../components/ServiceCard.astro";
import AreaCard from "../components/AreaCard.astro";
import CTABanner from "../components/CTABanner.astro";
import { siteConfig } from "../config/siteConfig";
import { getCollection } from "astro:content";

const services = (await getCollection("services")).sort(
  (a, b) => a.data.order - b.data.order,
);
const serviceAreas = await getCollection("serviceAreas");
---

<BaseLayout>
  <Hero
    title={`Trusted ${siteConfig.tagline.split(" ").slice(-1)[0]} in ${siteConfig.serviceArea}`}
    subtitle={`${siteConfig.businessName} delivers reliable, professional service you can count on. Serving ${siteConfig.serviceArea} and surrounding areas.`}
  />

  <!-- Services Section -->
  <section class="py-16 sm:py-20 bg-surface">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-3xl sm:text-4xl font-bold text-text">Our Services</h2>
        <p class="mt-4 text-lg text-text-muted">
          From routine maintenance to emergency repairs, we offer a full range of professional services.
        </p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {services.map((service) => (
          <ServiceCard
            title={service.data.title}
            description={service.data.description}
            slug={service.id}
            icon={service.data.icon}
            image={service.data.image}
          />
        ))}
      </div>
      <div class="text-center mt-10">
        <a
          href="/services"
          class="inline-flex items-center text-primary font-semibold hover:text-primary-dark transition-colors"
        >
          View all services
          <svg class="ml-2 h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Why Choose Us -->
  <section class="py-16 sm:py-20 bg-surface-alt">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-3xl sm:text-4xl font-bold text-text">Why Choose {siteConfig.businessName}?</h2>
        <p class="mt-4 text-lg text-text-muted">
          We're committed to providing the highest quality service at competitive prices.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="text-center p-6">
          <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-primary/10">
            <svg class="h-7 w-7 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-text">Licensed & Insured</h3>
          <p class="mt-2 text-text-muted">Fully licensed, bonded, and insured for your peace of mind.</p>
        </div>
        <div class="text-center p-6">
          <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-primary/10">
            <svg class="h-7 w-7 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-text">Fast Response</h3>
          <p class="mt-2 text-text-muted">Same-day service available. We know emergencies don't wait.</p>
        </div>
        <div class="text-center p-6">
          <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-primary/10">
            <svg class="h-7 w-7 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-text">Upfront Pricing</h3>
          <p class="mt-2 text-text-muted">No hidden fees. We provide clear estimates before any work begins.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Service Areas -->
  <section class="py-16 sm:py-20 bg-surface">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-3xl sm:text-4xl font-bold text-text">Areas We Serve</h2>
        <p class="mt-4 text-lg text-text-muted">
          Proudly serving communities across {siteConfig.serviceArea} and the surrounding metro area.
        </p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {serviceAreas.map((area) => (
          <AreaCard
            city={area.data.city}
            state={area.data.state}
            slug={area.id}
            description={area.data.description}
            image={area.data.image}
          />
        ))}
      </div>
      <div class="text-center mt-10">
        <a
          href="/service-areas"
          class="inline-flex items-center text-primary font-semibold hover:text-primary-dark transition-colors"
        >
          View all service areas
          <svg class="ml-2 h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <CTABanner />
</BaseLayout>
