              </span>
              <span class="font-medium break-all">{siteConfig.email}</span>
            </a>
            <a href={`tel:${siteConfig.phone.replace(/\D/g, "")}`} class="flex items-center gap-3 text-white hover:text-secondary transition-colors">
              <span class="flex h-10 w-10 items-center justify-center rounded-full bg-white/10">
                <Icon name="phone" class="h-5 w-5 text-secondary" />
              </span>
              <span class="font-medium">{siteConfig.phone}</span>
            </a>
            <p class="flex items-center gap-3 text-white/80">
              <span class="flex h-10 w-10 items-center justify-center rounded-full bg-white/10">
                <Icon name="map-pin" class="h-5 w-5 text-secondary" />
              </span>
              <span class="font-medium">Butuan City, Philippines · Remote available</span>
            </p>
          </div>
        </div>

        <div class="rounded-2xl border border-white/10 bg-white p-6 sm:p-8 shadow-2xl">
          <h3 class="font-heading text-xl font-bold text-text mb-2">Tell Me About Your Project</h3>
          <p class="text-sm text-text-muted mb-6">Share a few details and I'll get back to you soon.</p>
          <LeadForm
            formId="home-contact-form"
            variant="full"
            submitLabel="Send Project Details"
            messagePlaceholder="Tell me about your business, goals, timeline, and anything else that matters..."
          >
            <option slot="service-options" value="Website Design & Development">Website Design & Development</option>
            <option slot="service-options" value="WordPress Development">WordPress Development</option>
            <option slot="service-options" value="Landing Page Design">Landing Page Design</option>
            <option slot="service-options" value="Website Redesign">Website Redesign</option>
            <option slot="service-options" value="Local SEO">Local SEO</option>
            <option slot="service-options" value="Search Engine Optimization">Search Engine Optimization</option>
            <option slot="service-options" value="Graphic & Brand Design">Graphic & Brand Design</option>
            <option slot="service-options" value="Digital Marketing">Digital Marketing</option>
            <option slot="service-options" value="Website Maintenance">Website Maintenance</option>
            <option slot="service-options" value="Not Sure Yet">Not Sure Yet</option>
          </LeadForm>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
