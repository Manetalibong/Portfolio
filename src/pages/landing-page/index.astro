    }

    @media (min-width: 1100px) {
      .work-showcase-card {
        width: calc((min(100vw, 72rem) - 4rem) / 4.15);
      }
    }

    .work-showcase-card img {
      aspect-ratio: 16 / 11;
      width: 92%;
      margin: 0 auto;
      object-fit: contain;
      background: transparent;
    }

    .work-showcase-title {
