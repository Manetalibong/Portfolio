      gap: 1.25rem;
      width: max-content;
      animation: work-showcase-scroll var(--work-speed, 90s) linear infinite;
    }

    .work-showcase-reverse .work-showcase-inner {
      animation-direction: reverse;
    }

    .work-showcase-pause:hover .work-showcase-inner {
      animation-play-state: paused;
    }

    .work-showcase-card {
      flex: 0 0 auto;
      width: calc((100vw - 2.5rem) / 2.15);
      display: flex;
      flex-direction: column;
      overflow: visible;
      border-radius: 0;
      border: none;
      background: transparent;
      text-decoration: none;
      box-shadow: none;
