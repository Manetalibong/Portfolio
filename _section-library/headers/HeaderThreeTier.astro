---
/*
  HEADER — THREE TIER
  Professional contractor-style header with three rows:
  1. Top utility bar (dark): location text + quick links + social icons
  2. Middle bar (white): logo + service areas link + phone CTA
  3. Bottom nav bar (primary color): main navigation links
  
  On mobile, the top bar is hidden and the bottom nav collapses into a
  hamburger menu. The middle bar stays visible with logo + phone.
  
  Best for: established contractor businesses that want a bold,
  professional look with lots of info visible above the fold.
  
  To use: copy this file's contents into src/components/Header.astro
*/
import { siteConfig } from "../../src/config/siteConfig";
import { mainNav } from "../../src/config/navigation";

interface Props {
  topBarLinks?: { label: string; href: string; icon?: string }[];
}

const {
  topBarLinks = [],
} = Astro.props;

const currentPath = Astro.url.pathname;
const { socialLinks } = siteConfig;
---

<header class="sticky top-0 z-50">
  <!-- Tier 1: Top utility bar -->
  <div class="hidden lg:block bg-primary-dark text-white/80 text-xs">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-9">
        <!-- Left: Location -->
        <div class="flex items-center gap-1.5">
          <svg class="h-3.5 w-3.5 text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          <span>Serving {siteConfig.serviceArea} and surrounding areas</span>
        </div>

        <!-- Right: Quick links + Social -->
        <div class="flex items-center gap-5">
          {topBarLinks.map((link) => (
            <a href={link.href} class="flex items-center gap-1 hover:text-white transition-colors">
              {link.label}
            </a>
          ))}

          <!-- Social Icons -->
          <div class="flex items-center gap-2.5 ml-2 pl-3 border-l border-white/20">
            {socialLinks.facebook && (
              <a href={socialLinks.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="hover:text-white transition-colors">
                <svg class="h-3.5 w-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
              </a>
            )}
            {socialLinks.instagram && (
              <a href={socialLinks.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="hover:text-white transition-colors">
                <svg class="h-3.5 w-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
              </a>
            )}
            {socialLinks.youtube && (
              <a href={socialLinks.youtube} target="_blank" rel="noopener noreferrer" aria-label="YouTube" class="hover:text-white transition-colors">
                <svg class="h-3.5 w-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
              </a>
            )}
            {socialLinks.google && (
              <a href={socialLinks.google} target="_blank" rel="noopener noreferrer" aria-label="Google" class="hover:text-white transition-colors">
                <svg class="h-3.5 w-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 01-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg>
              </a>
            )}
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Tier 2: Logo + Service Areas + Phone -->
  <div class="bg-surface border-b border-border">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16 sm:h-20">
        <!-- Logo -->
        <a href="/" class="shrink-0">
          <img
            src={siteConfig.logo}
            alt={siteConfig.businessName}
            class="h-12 sm:h-14 w-auto"
            width="200"
            height="56"
          />
        </a>

        <!-- Right: Service Areas + Phone -->
        <div class="flex items-center gap-4 sm:gap-8">
          <a href="/service-areas" class="hidden md:flex items-center gap-2 group">
            <div class="flex h-9 w-9 items-center justify-center rounded-full bg-primary/10 group-hover:bg-primary/20 transition-colors">
              <svg class="h-5 w-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <div class="text-right">
              <p class="text-xs text-text-muted leading-none">View Our</p>
              <p class="text-sm font-bold text-text group-hover:text-primary transition-colors">Service Areas</p>
            </div>
          </a>

          <a href={`tel:${siteConfig.phone.replace(/\D/g, "")}`} class="flex items-center gap-2 group">
            <div class="flex h-9 w-9 items-center justify-center rounded-full bg-primary/10 group-hover:bg-primary/20 transition-colors">
              <svg class="h-5 w-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            </div>
            <div class="text-right">
              <p class="text-xs text-text-muted leading-none">Call Today</p>
              <p class="text-sm sm:text-base font-bold text-primary">{siteConfig.phone}</p>
            </div>
          </a>

          <!-- Mobile menu button (visible on mobile only) -->
          <button
            id="mobile-menu-btn"
            class="lg:hidden inline-flex items-center justify-center rounded-md p-2 text-text-muted hover:text-primary hover:bg-primary/5 transition-colors"
            aria-label="Open navigation menu"
            aria-expanded="false"
          >
            <svg id="menu-icon-open" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            <svg id="menu-icon-close" class="h-6 w-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Tier 3: Main navigation bar -->
  <nav class="hidden lg:block bg-primary">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-center h-12 gap-1">
        {mainNav.map((item) => (
          <a
            href={item.href}
            class:list={[
              "px-4 py-2 rounded text-sm font-semibold transition-colors",
              currentPath === item.href || (item.href !== "/" && currentPath.startsWith(item.href))
                ? "text-white bg-white/15"
                : "text-white/85 hover:text-white hover:bg-white/10",
            ]}
          >
            {item.label}
          </a>
        ))}
      </div>
    </div>
  </nav>

  <!-- Mobile Nav (full menu) -->
  <div id="mobile-menu" class="hidden lg:hidden bg-surface border-t border-border shadow-lg">
    <nav class="mx-auto max-w-7xl px-4 py-4 space-y-1">
      {mainNav.map((item) => (
        <a
          href={item.href}
          class:list={[
            "block px-3 py-2.5 rounded-md text-base font-medium transition-colors",
            currentPath === item.href || (item.href !== "/" && currentPath.startsWith(item.href))
              ? "text-primary bg-primary/5"
              : "text-text-muted hover:text-primary hover:bg-primary/5",
          ]}
        >
          {item.label}
        </a>
      ))}
      <div class="pt-3 mt-3 border-t border-border">
        <a
          href="/service-areas"
          class="block px-3 py-2.5 rounded-md text-base font-medium text-text-muted hover:text-primary hover:bg-primary/5 transition-colors"
        >
          Service Areas
        </a>
      </div>
      <a
        href={`tel:${siteConfig.phone.replace(/\D/g, "")}`}
        class="block mt-3 text-center rounded-lg bg-primary px-4 py-3 text-base font-semibold text-white hover:bg-primary-dark transition-colors"
      >
        Call {siteConfig.phone}
      </a>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");
  const iconOpen = document.getElementById("menu-icon-open");
  const iconClose = document.getElementById("menu-icon-close");

  btn?.addEventListener("click", () => {
    const isOpen = menu?.classList.toggle("hidden") === false;
    btn.setAttribute("aria-expanded", String(isOpen));
    iconOpen?.classList.toggle("hidden", isOpen);
    iconClose?.classList.toggle("hidden", !isOpen);
  });
</script>
