---
/*
  HEADER — TWO TIER
  Two-row header without the top utility bar:
  1. Top row (white): logo left + phone/CTA right
  2. Bottom row (primary color): centered main navigation
  
  Simpler than the three-tier but still feels premium.
  Mobile: collapses into logo + phone + hamburger.
  
  Best for: contractors who want a clean, professional look
  without the extra top bar. Good middle ground between
  HeaderSimple and HeaderThreeTier.
  
  To use: copy this file's contents into src/components/Header.astro
*/
import { siteConfig } from "../../src/config/siteConfig";
import { mainNav } from "../../src/config/navigation";

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50">
  <!-- Row 1: Logo + CTA -->
  <div class="bg-surface border-b border-border">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16 sm:h-20">
        <!-- Logo -->
        <a href="/" class="shrink-0">
          <img
            src={siteConfig.logo}
            alt={siteConfig.businessName}
            class="h-12 sm:h-14 w-auto"
            width="200"
            height="56"
          />
        </a>

        <!-- Right: Contact info + hamburger -->
        <div class="flex items-center gap-4 sm:gap-6">
          <div class="hidden sm:flex items-center gap-5">
            <a href={`mailto:${siteConfig.email}`} class="flex items-center gap-2 text-text-muted hover:text-primary transition-colors">
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              <span class="text-sm font-medium">{siteConfig.email}</span>
            </a>
            <a
              href={`tel:${siteConfig.phone.replace(/\D/g, "")}`}
              class="flex items-center gap-2 rounded-lg bg-primary px-5 py-2.5 text-sm font-bold text-white shadow-sm hover:bg-primary-dark transition-colors"
            >
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              {siteConfig.phone}
            </a>
          </div>

          <!-- Mobile: phone icon only -->
          <a
            href={`tel:${siteConfig.phone.replace(/\D/g, "")}`}
            class="sm:hidden inline-flex items-center justify-center rounded-full bg-primary p-2 text-white"
            aria-label={`Call ${siteConfig.phone}`}
          >
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
          </a>

          <!-- Mobile menu button -->
          <button
            id="mobile-menu-btn"
            class="lg:hidden inline-flex items-center justify-center rounded-md p-2 text-text-muted hover:text-primary hover:bg-primary/5 transition-colors"
            aria-label="Open navigation menu"
            aria-expanded="false"
          >
            <svg id="menu-icon-open" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            <svg id="menu-icon-close" class="h-6 w-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Row 2: Navigation bar -->
  <nav class="hidden lg:block bg-primary shadow-md">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-center h-12 gap-1">
        {mainNav.map((item) => (
          <a
            href={item.href}
            class:list={[
              "px-4 py-2 rounded text-sm font-semibold transition-colors",
              currentPath === item.href || (item.href !== "/" && currentPath.startsWith(item.href))
                ? "text-white bg-white/15"
                : "text-white/85 hover:text-white hover:bg-white/10",
            ]}
          >
            {item.label}
          </a>
        ))}
      </div>
    </div>
  </nav>

  <!-- Mobile Nav -->
  <div id="mobile-menu" class="hidden lg:hidden bg-surface border-t border-border shadow-lg">
    <nav class="mx-auto max-w-7xl px-4 py-4 space-y-1">
      {mainNav.map((item) => (
        <a
          href={item.href}
          class:list={[
            "block px-3 py-2.5 rounded-md text-base font-medium transition-colors",
            currentPath === item.href || (item.href !== "/" && currentPath.startsWith(item.href))
              ? "text-primary bg-primary/5"
              : "text-text-muted hover:text-primary hover:bg-primary/5",
          ]}
        >
          {item.label}
        </a>
      ))}
      <a
        href={`tel:${siteConfig.phone.replace(/\D/g, "")}`}
        class="block mt-3 text-center rounded-lg bg-primary px-4 py-3 text-base font-semibold text-white hover:bg-primary-dark transition-colors"
      >
        Call {siteConfig.phone}
      </a>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");
  const iconOpen = document.getElementById("menu-icon-open");
  const iconClose = document.getElementById("menu-icon-close");

  btn?.addEventListener("click", () => {
    const isOpen = menu?.classList.toggle("hidden") === false;
    btn.setAttribute("aria-expanded", String(isOpen));
    iconOpen?.classList.toggle("hidden", isOpen);
    iconClose?.classList.toggle("hidden", !isOpen);
  });
</script>
