---
/*
  CONTENT — MOSAIC + STATS
  Two-column layout: 4-image mosaic grid on the left (2x2 with varied
  sizes for visual interest), eyebrow + heading + description + stat
  counters on the right. Clean, editorial feel.

  Props:
  - images: array of 4 image objects { src, alt }
  - eyebrow, heading, description: content block
  - stats: array of { value, label }
*/
import { siteConfig } from "../../src/config/siteConfig";

interface ImageItem {
  src: string;
  alt?: string;
}

interface StatItem {
  value: string;
  label: string;
}

interface Props {
  eyebrow?: string;
  heading?: string;
  description?: string;
  images?: ImageItem[];
  stats?: StatItem[];
}

const {
  eyebrow = "What We Do",
  heading = "Quality Work, Trusted Results",
  description = `${siteConfig.businessName} brings years of hands-on experience to every project. From small repairs to large-scale installations, we deliver dependable service with craftsmanship you can count on.`,
  images = [
    { src: "/images/Preview/service1.jpg", alt: "Service work" },
    { src: "/images/Preview/service2.jpg", alt: "Team at work" },
    { src: "/images/Preview/service3.jpg", alt: "Project in progress" },
    { src: "/images/Preview/about.jpg", alt: "Completed project" },
  ],
  stats = [
    { value: "100+", label: "Happy Customers" },
    { value: "85+", label: "Projects Completed" },
    { value: "95+", label: "5-Star Reviews" },
  ],
} = Astro.props;

const img = (i: number) => images[i] || { src: "", alt: "" };
---

<section class="bg-surface py-16 sm:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">
      {/* Image mosaic — 2x2 grid with staggered sizes */}
      <div class="grid grid-cols-2 gap-3 sm:gap-4">
        {/* Top-left — shorter */}
        <div class="rounded-xl overflow-hidden self-end">
          <img
            src={img(0).src}
            alt={img(0).alt}
            class="w-full h-40 sm:h-48 lg:h-52 object-cover"
            loading="lazy"
            decoding="async"
          />
        </div>
        {/* Top-right — taller */}
        <div class="rounded-xl overflow-hidden">
          <img
            src={img(1).src}
            alt={img(1).alt}
            class="w-full h-48 sm:h-56 lg:h-64 object-cover"
            loading="lazy"
            decoding="async"
          />
        </div>
        {/* Bottom-left — taller */}
        <div class="rounded-xl overflow-hidden">
          <img
            src={img(2).src}
            alt={img(2).alt}
            class="w-full h-48 sm:h-56 lg:h-64 object-cover"
            loading="lazy"
            decoding="async"
          />
        </div>
        {/* Bottom-right — shorter */}
        <div class="rounded-xl overflow-hidden self-start">
          <img
            src={img(3).src}
            alt={img(3).alt}
            class="w-full h-40 sm:h-48 lg:h-52 object-cover"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>

      {/* Content + stats */}
      <div>
        {eyebrow && (
          <p class="text-sm font-bold uppercase tracking-wider text-secondary mb-3">{eyebrow}</p>
        )}
        <h2 class="text-3xl sm:text-4xl font-extrabold text-text leading-tight">{heading}</h2>
        {description && (
          <p class="mt-4 text-text-muted leading-relaxed text-sm sm:text-base">{description}</p>
        )}

        {stats.length > 0 && (
          <div class="flex flex-wrap gap-8 sm:gap-10 mt-8 pt-8 border-t border-border">
            {stats.map((stat) => (
              <div>
                <p class="text-3xl sm:text-4xl font-extrabold text-secondary leading-none">{stat.value}</p>
                <p class="text-sm text-text-muted mt-1.5 font-medium">{stat.label}</p>
              </div>
            ))}
          </div>
        )}
      </div>
    </div>
  </div>
</section>
