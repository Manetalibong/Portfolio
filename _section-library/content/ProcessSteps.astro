---
/*
  PROCESS STEPS
  Centered "How It Works" section with eyebrow, heading, description,
  a row of 3–4 step cards with icons and connecting curved arrows
  between them, plus an optional CTA button.

  Clean and simple — works on any page to explain the company's
  workflow or how customers get started.

  Props:
  - eyebrow, heading, description: text content
  - steps: array of { icon, title, description }
  - ctaLabel, ctaHref: optional CTA button
  - columns: 3 | 4 (default 3)
*/
import { siteConfig } from "../../src/config/siteConfig";
import Icon from "../../src/components/Icon.astro";

interface StepItem {
  icon?: string;
  title: string;
  description: string;
}

interface Props {
  eyebrow?: string;
  heading?: string;
  description?: string;
  steps?: StepItem[];
  ctaLabel?: string;
  ctaHref?: string;
  columns?: 3 | 4;
}

const {
  eyebrow = "Our Process",
  heading = "How It Works",
  description = `Getting started with ${siteConfig.businessName} is simple. We've streamlined our process so you can go from first call to finished project with zero stress.`,
  steps = [
    {
      icon: "phone",
      title: "Contact Us",
      description: "Give us a call or fill out our online form to schedule your free consultation.",
    },
    {
      icon: "clipboard",
      title: "Initial Evaluation",
      description: "Our expert team assesses your needs and provides a transparent, no-obligation quote.",
    },
    {
      icon: "settings",
      title: "Develop a Plan",
      description: "We create a detailed plan tailored to your property, timeline, and budget.",
    },
  ],
  ctaLabel = "",
  ctaHref = "/contact",
  columns = 3,
} = Astro.props;

const gridClass = columns === 4
  ? "grid-cols-1 sm:grid-cols-2 lg:grid-cols-4"
  : "grid-cols-1 sm:grid-cols-3";
---

<section class="bg-surface py-16 sm:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto mb-14">
      {eyebrow && (
        <p class="text-sm font-bold uppercase tracking-wider text-secondary mb-3">{eyebrow}</p>
      )}
      <h2 class="text-3xl sm:text-4xl font-extrabold text-text">{heading}</h2>
      {description && (
        <p class="mt-4 text-text-muted leading-relaxed">{description}</p>
      )}
    </div>

    <!-- Steps grid with arrows -->
    <div class={`grid ${gridClass} gap-8 sm:gap-6 lg:gap-10 relative`}>
      {steps.map((step, i) => (
        <div class="relative text-center px-2">
          {/* Icon circle */}
          <div class="relative inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-secondary/10 mb-5 group">
            <Icon name={step.icon || "check-circle"} class="h-7 w-7 text-secondary" />
            {/* Step number badge */}
            <span class="absolute -top-2 -right-2 flex items-center justify-center h-6 w-6 rounded-full bg-primary text-white text-xs font-bold shadow-sm">
              {i + 1}
            </span>
          </div>

          {/* Curved arrow (hidden on last item and on mobile) */}
          {i < steps.length - 1 && (
            <div class="hidden sm:block absolute top-8 left-[calc(50%+48px)] w-[calc(100%-96px)] pointer-events-none" aria-hidden="true">
              <svg class="w-full h-8 text-gray-300" viewBox="0 0 200 32" fill="none" preserveAspectRatio="none">
                <path
                  d="M0,24 C50,24 50,8 100,8 C150,8 150,24 200,24"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-dasharray="6 4"
                  fill="none"
                />
                <path
                  d="M194,19 L200,24 L194,29"
                  stroke="currentColor"
                  stroke-width="2"
                  fill="none"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </div>
          )}

          <h3 class="text-lg font-bold text-text mb-2">{step.title}</h3>
          <p class="text-sm text-text-muted leading-relaxed max-w-xs mx-auto">{step.description}</p>
        </div>
      ))}
    </div>

    {/* CTA */}
    {ctaLabel && (
      <div class="text-center mt-12">
        <a
          href={ctaHref}
          class="inline-flex items-center gap-2 rounded-lg bg-secondary px-6 py-3 text-sm font-bold text-white shadow-lg hover:bg-secondary-light transition-colors"
        >
          {ctaLabel}
          <Icon name="arrow-right" class="h-4 w-4" />
        </a>
      </div>
    )}
  </div>
</section>
