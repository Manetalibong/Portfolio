---
/*
 * One featured quote: large decorative quotation marks, oversized body text, name and stars centered below.
 * Compact social proof for footers, mid-page breaks, or landing pages where a full grid feels like too much.
 */
import { siteConfig } from "../../src/config/siteConfig";

export interface Testimonial {
  name: string;
  text: string;
  rating: number;
}

interface Props {
  testimonials?: Testimonial[];
  kicker?: string;
}

const defaultTestimonials: Testimonial[] = [
  {
    name: "John D.",
    text: "Excellent service! They were on time, professional, and fixed our issue quickly. Highly recommend.",
    rating: 5,
  },
  {
    name: "Sarah M.",
    text: "Best experience we've ever had with a service company. Fair pricing and outstanding work.",
    rating: 5,
  },
  {
    name: "Mike R.",
    text: "Called them for an emergency and they were here within the hour. Saved us from a major disaster. Will definitely use again.",
    rating: 5,
  },
];

const { testimonials = defaultTestimonials, kicker = "Customer story" } = Astro.props;

const featured = testimonials[0] ?? defaultTestimonials[0]!;
---

<section class="border-y border-border bg-surface py-14 sm:py-16">
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
    <div class="text-center">
      <p class="text-xs font-semibold uppercase tracking-widest text-primary">{kicker}</p>
      <div class="mx-auto mt-3 h-1 w-12 rounded-full bg-secondary" aria-hidden="true"></div>
    </div>

    <div class="relative mt-8 text-center">
      <span
        class="pointer-events-none absolute left-1/2 top-0 -translate-x-1/2 -translate-y-2 select-none font-serif text-[5rem] leading-none text-primary/15 sm:text-[6.5rem]"
        aria-hidden="true"
      >
        &ldquo;
      </span>
      <blockquote class="relative z-10 px-2 sm:px-8">
        <p class="text-xl font-medium leading-relaxed text-text sm:text-2xl lg:text-3xl">
          {featured.text}
        </p>
      </blockquote>
    </div>

    <div class="mt-10 flex flex-col items-center gap-3">
      <div class="flex gap-0.5" aria-hidden="true">
        {Array.from({ length: Math.min(Math.max(featured.rating, 0), 5) }, () => (
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 20 20"
            fill="currentColor"
            class="h-5 w-5 sm:h-6 sm:w-6 text-amber-400"
          >
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
          </svg>
        ))}
      </div>
      <p class="text-base font-semibold text-text">{featured.name}</p>
      <p class="text-sm text-text-muted">{siteConfig.businessName} &middot; {siteConfig.serviceArea}</p>
    </div>
  </div>
</section>
