---
/*
 * Asymmetric split: a wide featured quote on the left (~60%) with big type and quote marks,
 * and two compact review cards stacked on the right (~40%), all with star ratings.
 * Use when you want one hero review plus supporting quotes—strong trust signal on home or about pages.
 */
import { siteConfig } from "../../src/config/siteConfig";

export interface Testimonial {
  name: string;
  text: string;
  rating: number;
}

interface Props {
  testimonials?: Testimonial[];
  heading?: string;
  subheading?: string;
}

const defaultTestimonials: Testimonial[] = [
  {
    name: "John D.",
    text: "Excellent service! They were on time, professional, and fixed our issue quickly. Highly recommend.",
    rating: 5,
  },
  {
    name: "Sarah M.",
    text: "Best experience we've ever had with a service company. Fair pricing and outstanding work.",
    rating: 5,
  },
  {
    name: "Mike R.",
    text: "Called them for an emergency and they were here within the hour. Saved us from a major disaster. Will definitely use again.",
    rating: 5,
  },
];

const {
  testimonials = defaultTestimonials,
  heading = "Why Homeowners Trust Us",
  subheading = `Real reviews from ${siteConfig.serviceArea}`,
} = Astro.props;

const featured = testimonials[0] ?? defaultTestimonials[0]!;
const secondary = testimonials.slice(1, 3);
---

<section class="bg-surface py-16 sm:py-20 lg:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl text-center lg:mx-0 lg:max-w-none lg:text-left">
      <h2 class="font-heading text-3xl font-bold tracking-tight text-primary-dark sm:text-4xl">
        {heading}
      </h2>
      <p class="mt-3 text-lg text-text-muted">{subheading}</p>
    </div>

    <div class="mt-12 flex flex-col gap-8 lg:flex-row lg:items-stretch lg:gap-10">
      <div
        class:list={[
          "relative flex min-h-[280px] flex-1 flex-col rounded-2xl border border-border border-l-4 border-l-accent bg-surface-alt p-8 shadow-lg shadow-text/5",
          secondary.length > 0 ? "lg:max-w-[60%] lg:flex-[1.5]" : "lg:w-full",
        ]}
      >
        <span
          class="pointer-events-none absolute left-6 top-4 font-serif text-7xl leading-none text-primary/20 sm:left-8 sm:text-8xl"
          aria-hidden="true"
        >
          &ldquo;
        </span>
        <div class="relative z-10 mt-10 flex flex-1 flex-col">
          <blockquote class="flex-1">
            <p class="text-xl font-medium leading-relaxed text-text sm:text-2xl lg:text-[1.65rem] lg:leading-snug">
              {featured.text}
            </p>
          </blockquote>
          <div class="mt-8 flex flex-wrap items-center gap-4 border-t border-border pt-6">
            <div class="flex gap-0.5" aria-hidden="true">
              {Array.from({ length: Math.min(Math.max(featured.rating, 0), 5) }, () => (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 20 20"
                  fill="currentColor"
                  class="h-5 w-5 text-amber-400"
                >
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              ))}
            </div>
            <p class="text-base font-bold text-text">{featured.name}</p>
          </div>
        </div>
      </div>

      {
        secondary.length > 0 && (
          <div class="flex flex-1 flex-col gap-6 lg:max-w-[40%] lg:flex-[1]">
            {secondary.map((t) => (
              <article class="flex flex-1 flex-col rounded-xl border border-border bg-surface p-6 shadow-md">
                <div class="flex gap-0.5" aria-hidden="true">
                  {Array.from({ length: Math.min(Math.max(t.rating, 0), 5) }, () => (
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 20 20"
                      fill="currentColor"
                      class="h-4 w-4 text-amber-400"
                    >
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                    </svg>
                  ))}
                </div>
                <blockquote class="mt-3 flex-1">
                  <p class="text-sm leading-relaxed text-text sm:text-base">&ldquo;{t.text}&rdquo;</p>
                </blockquote>
                <p class="mt-4 text-sm font-bold text-text">{t.name}</p>
              </article>
            ))}
          </div>
        )
      }
    </div>
  </div>
</section>
