---
/*
  SERVICES SHOWCASE
  Split header (eyebrow + heading left, description right) above a
  4-column grid of service cards with images, titles, descriptions,
  and "Get Started" links.
  
  Great for the homepage or a services overview page to highlight
  top services with visual cards. Each card links to its service page.
  
  Props:
  - eyebrow, heading, description: header content
  - services: array of { title, description, image, href, linkLabel }
*/
import { siteConfig } from "../../src/config/siteConfig";

interface ServiceItem {
  title: string;
  description: string;
  image: string;
  href: string;
  linkLabel?: string;
}

interface Props {
  eyebrow?: string;
  heading?: string;
  description?: string;
  services?: ServiceItem[];
}

const defaultServices: ServiceItem[] = [
  {
    title: "Emergency Repairs",
    description: "We provide fast, reliable emergency service when you need it most — day or night.",
    image: "/images/service-1.jpg",
    href: "/services",
  },
  {
    title: "New Installations",
    description: "Professional installation of top-rated systems with industry-leading warranties.",
    image: "/images/service-2.jpg",
    href: "/services",
  },
  {
    title: "Maintenance Plans",
    description: "Keep your systems running at peak performance with regular tune-ups and inspections.",
    image: "/images/service-3.jpg",
    href: "/services",
  },
  {
    title: "Inspections & Diagnostics",
    description: "Thorough assessments using the latest tools to pinpoint problems fast.",
    image: "/images/service-4.jpg",
    href: "/services",
  },
];

const {
  eyebrow = "Our Services",
  heading = `Grow Your Business with ${siteConfig.businessName}`,
  description = `From routine maintenance to complex installations, our team delivers the highest quality workmanship in ${siteConfig.serviceArea}. Every project is backed by our commitment to excellence and customer satisfaction.`,
  services = defaultServices,
} = Astro.props;
---

<section class="py-16 sm:py-20 bg-surface">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Split header -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-16 mb-12 sm:mb-16">
      <div>
        {eyebrow && (
          <p class="text-sm font-bold uppercase tracking-wider text-secondary mb-3">{eyebrow}</p>
        )}
        <h2 class="text-3xl sm:text-4xl font-bold text-text leading-tight">{heading}</h2>
      </div>
      {description && (
        <div class="flex items-end">
          <p class="text-text-muted leading-relaxed lg:border-l-2 lg:border-border lg:pl-8">{description}</p>
        </div>
      )}
    </div>

    <!-- Service cards grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-8">
      {services.map((service) => (
        <div class="group">
          <a href={service.href} class="block mb-5 overflow-hidden rounded-xl">
            <img
              src={service.image}
              alt={service.title}
              class="h-52 w-full object-cover transition-transform duration-300 group-hover:scale-105"
              loading="lazy"
            />
          </a>
          <h3 class="text-lg font-bold text-text mb-2">{service.title}</h3>
          <p class="text-sm text-text-muted mb-3 leading-relaxed">{service.description}</p>
          <a
            href={service.href}
            class="inline-flex items-center gap-1 text-sm font-semibold text-secondary hover:text-secondary-light transition-colors"
          >
            {service.linkLabel || "Get Started"}
            <svg class="h-4 w-4 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      ))}
    </div>
  </div>
</section>
