---
/*
 * Three stacked rows that alternate image and copy (left/right/left). Each row sells one
 * value with a short paragraph and bullets. Best for storytelling and proof—use when you
 * have strong project photos and want visitors to linger on benefits like craftsmanship
 * and reliability before they scroll to testimonials or CTAs.
 */
import { siteConfig } from "../../src/config/siteConfig";

export interface AlternatingFeature {
  title: string;
  description: string;
  bullets: string[];
  image: string;
  imageAlt?: string;
}

export interface Props {
  eyebrow?: string;
  /** Three items yield the classic alternating layout; fewer/more rows still alternate from row 1. */
  features?: AlternatingFeature[];
}

const defaultFeatures: AlternatingFeature[] = [
  {
    title: "Expert Craftsmanship",
    description: `At ${siteConfig.businessName}, we treat every home like our own. From careful prep to spotless cleanup, our crews deliver finishes that last.`,
    bullets: [
      "Trained technicians on every job",
      "Premium materials matched to your needs",
      "Attention to detail on trim, seals, and safety",
    ],
    image:
      "https://images.unsplash.com/photo-1504307651254-35680f356dfd?auto=format&fit=crop&w=1200&q=80",
    imageAlt: "Contractor measuring and planning work on site",
  },
  {
    title: "Reliable & On Time",
    description:
      "We respect your schedule. Clear arrival windows, prompt updates, and work completed on the timeline we agree on—so you can plan your day with confidence.",
    bullets: [
      "Text or call updates when we’re on the way",
      "Stocked trucks to finish most jobs in one visit",
      "Flexible scheduling across our service area",
    ],
    image:
      "https://images.unsplash.com/photo-1581578731548-c64695cc6952?auto=format&fit=crop&w=1200&q=80",
    imageAlt: "Service van and technician arriving at a home",
  },
  {
    title: "Transparent Pricing",
    description:
      "No jargon and no bait-and-switch. You’ll see line-item clarity on labor and materials before we start, with options that fit your budget.",
    bullets: [
      "Written estimates you can review at your pace",
      "Options explained in plain language",
      "No hidden trip or “surprise” fees",
    ],
    image:
      "https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?auto=format&fit=crop&w=1200&q=80",
    imageAlt: "Reviewing a project estimate with a homeowner",
  },
];

const { eyebrow = "Why homeowners choose us", features = defaultFeatures } = Astro.props;
---

<section class="bg-surface py-16 sm:py-24" aria-labelledby="features-alternating-heading">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <p class="text-center text-sm font-semibold uppercase tracking-wide text-primary">{eyebrow}</p>
    <h2
      id="features-alternating-heading"
      class="font-heading mt-2 text-center text-3xl font-bold tracking-tight text-text sm:text-4xl"
    >
      Built on trust, {siteConfig.serviceArea}
    </h2>
    <p class="mx-auto mt-4 max-w-2xl text-center text-lg text-text-muted">
      Real solutions, clear communication, and workmanship you can stand behind.
    </p>

    <div class="mt-16 flex flex-col gap-20 lg:gap-28">
      {
        features.map((feature, index) => {
          const imageOnLeft = index % 2 === 1;
          return (
            <div
              class:list={[
                "flex flex-col gap-10 lg:items-center",
                imageOnLeft ? "lg:flex-row-reverse" : "lg:flex-row",
              ]}
            >
              <div class="flex-1 lg:w-1/2">
                <div class:list={[imageOnLeft ? "lg:pl-8 xl:pl-12" : "lg:pr-8 xl:pr-12"]}>
                  <h3 class="font-heading text-2xl font-bold text-text sm:text-3xl">{feature.title}</h3>
                  <p class="mt-4 text-base leading-relaxed text-text-muted">{feature.description}</p>
                  <ul class="mt-6 space-y-3 border-l-2 border-secondary/40 pl-5">
                    {feature.bullets.map((bullet) => (
                      <li class="text-sm font-medium text-text sm:text-base">{bullet}</li>
                    ))}
                  </ul>
                </div>
              </div>
              <div class="flex-1 lg:w-1/2">
                <div class="overflow-hidden rounded-xl shadow-lg shadow-text/5 ring-1 ring-border">
                  <img
                    src={feature.image}
                    alt={feature.imageAlt ?? feature.title}
                    class="h-full w-full object-cover"
                    width="1200"
                    height="800"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              </div>
            </div>
          );
        })
      }
    </div>
  </div>
</section>
