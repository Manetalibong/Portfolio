---
/*
  SERVICES IMAGE STRIP
  Split header (eyebrow + heading left, description right) above a
  full-width strip of edge-to-edge image tiles. Each tile has a dark
  gradient overlay at the bottom with the service title. Tiles link
  to service pages.
  
  High visual impact — the images do the talking. Works best with
  5 strong photos, but handles 3–6 gracefully.
  
  Props:
  - eyebrow, heading, description: header content
  - services: array of { title, image, href }
*/
import { siteConfig } from "../../src/config/siteConfig";

interface ServiceTile {
  title: string;
  image: string;
  href: string;
}

interface Props {
  eyebrow?: string;
  heading?: string;
  description?: string;
  services?: ServiceTile[];
}

const defaultServices: ServiceTile[] = [
  { title: "Emergency Repairs", image: "/images/service-1.jpg", href: "/services" },
  { title: "Installations", image: "/images/service-2.jpg", href: "/services" },
  { title: "Maintenance", image: "/images/service-3.jpg", href: "/services" },
  { title: "Inspections", image: "/images/service-4.jpg", href: "/services" },
  { title: "Replacements", image: "/images/service-5.jpg", href: "/services" },
];

const {
  eyebrow = "Our Services",
  heading = `We've Got You Covered`,
  description = `From routine maintenance to complex installations, our certified team delivers the highest quality workmanship across ${siteConfig.serviceArea}.`,
  services = defaultServices,
} = Astro.props;
---

<section class="py-16 sm:py-20 bg-surface">
  <!-- Split header -->
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 mb-10 sm:mb-14">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-16">
      <div>
        {eyebrow && (
          <p class="text-sm font-bold uppercase tracking-wider text-secondary mb-3">{eyebrow}</p>
        )}
        <h2 class="text-3xl sm:text-4xl font-bold text-text leading-tight">{heading}</h2>
      </div>
      {description && (
        <div class="flex items-end">
          <p class="text-text-muted leading-relaxed lg:border-l-2 lg:border-border lg:pl-8">{description}</p>
        </div>
      )}
    </div>
  </div>

  <!-- Image strip -->
  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5">
    {services.map((service) => (
      <a href={service.href} class="group relative block overflow-hidden aspect-[3/4]">
        <img
          src={service.image}
          alt={service.title}
          class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/10 to-transparent" />
        <div class="absolute bottom-0 left-0 right-0 p-4 sm:p-5">
          <h3 class="text-base sm:text-lg font-bold text-white">{service.title}</h3>
        </div>
      </a>
    ))}
  </div>
</section>
