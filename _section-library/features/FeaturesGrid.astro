---
/*
 * “Why choose us” as a dense grid: section headline plus six feature cards in three columns.
 * Icons sit in soft primary-tinted rounds with centered copy. Best when you want to scan
 * many trust signals at once (licensing, speed, pricing) without long prose—typical mid-page
 * on contractor home pages.
 */
import { siteConfig } from "../../src/config/siteConfig";

export interface FeatureItem {
  title: string;
  description: string;
  /** SVG path `d` for a 24×24 outline icon (stroke). */
  iconPath?: string;
}

export interface Props {
  heading?: string;
  /** When omitted, six contractor-focused defaults are used. */
  features?: FeatureItem[];
}

const defaultIconPaths = {
  shield:
    "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z",
  bolt: "M13 10V3L4 14h7v7l9-11h-7z",
  currency:
    "M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1",
  checkCircle:
    "M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z",
  users:
    "M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z",
  mapPin:
    "M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z M15 11a3 3 0 11-6 0 3 3 0 016 0z",
} as const;

const defaultFeatures: FeatureItem[] = [
  {
    title: "Licensed & Insured",
    description: "Fully licensed pros with liability coverage so you’re protected on every job.",
    iconPath: defaultIconPaths.shield,
  },
  {
    title: "Fast Response",
    description: "We prioritize urgent calls and aim to get a technician to you quickly.",
    iconPath: defaultIconPaths.bolt,
  },
  {
    title: "Upfront Pricing",
    description: "Clear estimates before work begins—no surprise fees when the bill arrives.",
    iconPath: defaultIconPaths.currency,
  },
  {
    title: "Satisfaction Guaranteed",
    description: "We stand behind our work and won’t walk away until you’re happy.",
    iconPath: defaultIconPaths.checkCircle,
  },
  {
    title: "Experienced Team",
    description: "Skilled tradespeople who’ve seen it all and fix it right the first time.",
    iconPath: defaultIconPaths.users,
  },
  {
    title: "Local & Trusted",
    description: `Proud to serve ${siteConfig.serviceArea} with honest, neighborly service.`,
    iconPath: defaultIconPaths.mapPin,
  },
];

const {
  heading = `Why Choose ${siteConfig.businessName}?`,
  features = defaultFeatures,
} = Astro.props;
---

<section class="bg-surface-alt py-16 sm:py-20" aria-labelledby="features-grid-heading">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl text-center">
      <h2
        id="features-grid-heading"
        class="font-heading text-3xl font-bold tracking-tight text-text sm:text-4xl"
      >
        {heading}
      </h2>
      <p class="mt-4 text-lg text-text-muted">
        Quality workmanship and clear communication from quote to completion.
      </p>
    </div>

    <ul
      class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3"
      role="list"
    >
      {
        features.map((feature, index) => (
          <li
            class:list={[
              "rounded-2xl border border-border p-8 text-center shadow-sm transition-shadow hover:shadow-md",
              index % 2 === 0 ? "bg-surface" : "bg-surface-alt",
            ]}
          >
            <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-primary/10">
              <svg
                class="h-7 w-7 text-primary"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d={feature.iconPath ?? defaultIconPaths.shield}
                />
              </svg>
            </div>
            <h3 class="mt-5 font-heading text-lg font-semibold text-text">{feature.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-text-muted">{feature.description}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
