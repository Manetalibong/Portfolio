---
/*
 * Full-width band in brand primary: headline and supporting line on the left, two actions
 * on the right (solid “free estimate” and outlined call with phone icon). Stacks and
 * centers on small screens. Use as a strong conversion strip above the footer or mid-page.
 */
import { siteConfig } from "../../src/config/siteConfig";

export interface Props {
  headline?: string;
  subtitle?: string;
  estimateLabel?: string;
  estimateHref?: string;
  callLabel?: string;
}

const {
  headline = "Ready for a job done right the first time?",
  subtitle = `Call ${siteConfig.businessName} today—we serve ${siteConfig.serviceArea} and surrounding areas.`,
  estimateLabel = "Get a Free Estimate",
  estimateHref = "/contact",
  callLabel = siteConfig.phone,
} = Astro.props;

const telHref = `tel:${siteConfig.phone.replace(/\D/g, "")}`;
---

<section
  class="w-full bg-primary px-4 py-10 sm:px-6 lg:px-10 lg:py-12"
  aria-labelledby="cta-banner-heading"
>
  <div
    class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-8 lg:flex-row lg:items-center lg:gap-10"
  >
    <div class="max-w-2xl text-center lg:text-left">
      <h2
        id="cta-banner-heading"
        class="font-heading text-2xl font-bold tracking-tight text-surface sm:text-3xl"
      >
        {headline}
      </h2>
      <p class="mt-3 text-base leading-relaxed text-white/90 sm:text-lg">{subtitle}</p>
    </div>
    <div
      class="flex w-full max-w-md flex-col items-stretch justify-center gap-3 sm:flex-row sm:items-center lg:w-auto lg:max-w-none lg:flex-shrink-0"
    >
      <a
        href={estimateHref}
        class="inline-flex items-center justify-center rounded-lg bg-surface px-6 py-3.5 text-center text-base font-semibold text-primary shadow-md transition hover:bg-surface-alt focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-surface"
      >
        {estimateLabel}
      </a>
      <a
        href={telHref}
        class="inline-flex items-center justify-center gap-2 rounded-lg border-2 border-white/80 bg-transparent px-6 py-3.5 text-base font-semibold text-surface transition hover:border-surface hover:bg-white/10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-surface"
      >
        <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"
            fill="currentColor"></path>
        </svg>
        {callLabel}
      </a>
    </div>
  </div>
</section>
