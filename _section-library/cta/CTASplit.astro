---
/*
 * Bold dark section: oversized headline, subtitle, and two CTAs on the left; a rounded
 * lifestyle or project photo on the right. Stacks on mobile with the image below the copy.
 * Use for high-impact “work with us” moments on home or landing pages.
 */
import { siteConfig } from "../../src/config/siteConfig";

export interface Props {
  headline?: string;
  subtitle?: string;
  imageSrc?: string;
  imageAlt?: string;
  estimateLabel?: string;
  estimateHref?: string;
  callLabel?: string;
}

const {
  headline = "Quality work. Clear communication. Lasting results.",
  subtitle = `${siteConfig.businessName} is your partner for dependable service in ${siteConfig.serviceArea}.`,
  imageSrc = "https://images.unsplash.com/photo-1503387762-592deb58ef4e?auto=format&fit=crop&w=1200&q=80",
  imageAlt = "Professional contractor work",
  estimateLabel = "Get a Free Estimate",
  estimateHref = "/contact",
  callLabel = `Call ${siteConfig.phone}`,
} = Astro.props;

const telHref = `tel:${siteConfig.phone.replace(/\D/g, "")}`;
---

<section
  class="w-full bg-gray-900 px-4 py-14 sm:px-6 lg:px-10 lg:py-20"
  aria-labelledby="cta-split-heading"
>
  <div class="mx-auto grid max-w-6xl items-center gap-10 lg:grid-cols-2 lg:gap-14">
    <div class="text-center lg:text-left">
      <h2
        id="cta-split-heading"
        class="font-heading text-3xl font-bold tracking-tight text-white sm:text-4xl lg:text-5xl"
      >
        {headline}
      </h2>
      <p class="mt-5 text-lg leading-relaxed text-white/80">{subtitle}</p>
      <div class="mt-8 flex flex-col items-stretch justify-center gap-3 sm:flex-row sm:justify-center lg:justify-start">
        <a
          href={estimateHref}
          class="inline-flex items-center justify-center rounded-xl bg-secondary px-6 py-3.5 text-base font-semibold text-gray-900 shadow-lg shadow-secondary/20 transition hover:bg-secondary-light focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-secondary"
        >
          {estimateLabel}
        </a>
        <a
          href={telHref}
          class="inline-flex items-center justify-center rounded-xl border border-white/30 bg-white/5 px-6 py-3.5 text-base font-semibold text-white backdrop-blur-sm transition hover:border-accent hover:bg-accent/10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        >
          {callLabel}
        </a>
      </div>
    </div>
    <div class="relative overflow-hidden rounded-2xl shadow-2xl shadow-black/40 ring-1 ring-white/10">
      <img
        src={imageSrc}
        alt={imageAlt}
        class="aspect-[4/3] w-full object-cover sm:aspect-[5/4] lg:aspect-auto lg:min-h-[22rem]"
        width="1200"
        height="900"
        loading="lazy"
        decoding="async"
      />
    </div>
  </div>
</section>
