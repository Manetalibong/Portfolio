---
/*
  SERVICE PAGE — FULL WIDTH LAYOUT
  No sidebar. Full-width hero image, then centered prose content,
  then features displayed as a horizontal card grid, then a CTA banner.
  Best for: services where the markdown content is the star and you
  want a clean, editorial reading experience.

  To use: copy this file's contents into src/pages/services/[slug].astro
*/
import BaseLayout from "../../layouts/BaseLayout.astro";
import CTABanner from "../../components/CTABanner.astro";
import { siteConfig } from "../../config/siteConfig";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const services = await getCollection("services");
  return services.map((service) => ({
    params: { slug: service.id },
    props: { service },
  }));
}

const { service } = Astro.props;
const { Content } = await render(service);
const { title, description, metaTitle, metaDescription, image, features } = service.data;
---

<BaseLayout
  title={metaTitle || `${title} | ${siteConfig.businessName}`}
  description={metaDescription || description}
  image={image}
  schema="Service"
>
  <section class="bg-primary py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <nav class="mb-4 text-sm text-white/60">
        <a href="/" class="hover:text-white transition-colors">Home</a>
        <span class="mx-2">/</span>
        <a href="/services" class="hover:text-white transition-colors">Services</a>
        <span class="mx-2">/</span>
        <span class="text-white">{title}</span>
      </nav>
      <h1 class="text-4xl sm:text-5xl font-bold text-white">{title}</h1>
      <p class="mt-4 text-lg text-white/80 max-w-3xl">{description}</p>
    </div>
  </section>

  {image && (
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 -mt-6">
      <img
        src={image}
        alt={title}
        class="w-full rounded-xl aspect-[21/9] object-cover shadow-lg"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  )}

  <article class="py-16 sm:py-20 bg-surface">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <div class="prose prose-lg max-w-none prose-headings:text-text prose-p:text-text-muted prose-a:text-primary">
        <Content />
      </div>
    </div>
  </article>

  {features.length > 0 && (
    <section class="py-16 bg-surface-alt">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl sm:text-3xl font-bold text-text text-center mb-10">What's Included</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {features.map((feature) => (
            <div class="flex items-start gap-4 rounded-xl border border-border bg-surface p-5">
              <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-accent/10 shrink-0">
                <svg class="h-5 w-5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <span class="text-text-muted font-medium">{feature}</span>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <CTABanner />
</BaseLayout>
