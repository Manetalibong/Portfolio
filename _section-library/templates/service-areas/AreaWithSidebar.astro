---
/*
  SERVICE AREA PAGE — SIDEBAR LAYOUT
  Content on the left (2/3 width), sidebar on the right (1/3 width).
  Sidebar has quick links to all services, a phone CTA card,
  and a list of other service areas. Good for internal linking / SEO juice.
  Best for: when you want to maximize internal links between areas and services.

  To use: copy this file's contents into src/pages/service-areas/[slug].astro
*/
import BaseLayout from "../../layouts/BaseLayout.astro";
import CTABanner from "../../components/CTABanner.astro";
import { siteConfig } from "../../config/siteConfig";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const serviceAreas = await getCollection("serviceAreas");
  return serviceAreas.map((area) => ({
    params: { slug: area.id },
    props: { area },
  }));
}

const { area } = Astro.props;
const { Content } = await render(area);
const { city, state, description, metaTitle, metaDescription, image } = area.data;

const services = (await getCollection("services")).sort(
  (a, b) => a.data.order - b.data.order,
);

const allAreas = (await getCollection("serviceAreas")).filter(
  (a) => a.id !== area.id,
);
---

<BaseLayout
  title={metaTitle || `${siteConfig.businessName} in ${city}, ${state}`}
  description={metaDescription || description}
  image={image}
>
  <section class="bg-primary py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <nav class="mb-4 text-sm text-white/60">
        <a href="/" class="hover:text-white transition-colors">Home</a>
        <span class="mx-2">/</span>
        <a href="/service-areas" class="hover:text-white transition-colors">Service Areas</a>
        <span class="mx-2">/</span>
        <span class="text-white">{city}, {state}</span>
      </nav>
      <h1 class="text-4xl sm:text-5xl font-bold text-white">
        {siteConfig.businessName} in {city}, {state}
      </h1>
      <p class="mt-4 text-lg text-white/80 max-w-3xl">{description}</p>
    </div>
  </section>

  <section class="py-16 sm:py-20 bg-surface">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <!-- Main Content -->
        <div class="lg:col-span-2">
          {image && (
            <img
              src={image}
              alt={`${city}, ${state}`}
              class="w-full rounded-xl mb-8 aspect-video object-cover"
              loading="lazy"
            />
          )}
          <div class="prose prose-lg max-w-none prose-headings:text-text prose-p:text-text-muted prose-a:text-primary">
            <Content />
          </div>
        </div>

        <!-- Sidebar -->
        <aside class="lg:col-span-1 space-y-6">
          <!-- CTA Card -->
          <div class="rounded-xl bg-primary p-6 text-white">
            <h3 class="text-lg font-semibold mb-2">Need Service in {city}?</h3>
            <p class="text-sm text-white/80 mb-4">
              We're ready to help. Contact us today for a free estimate.
            </p>
            <a
              href="/contact"
              class="block w-full text-center rounded-lg bg-white px-4 py-2.5 text-sm font-semibold text-primary hover:bg-gray-100 transition-colors"
            >
              Get a Free Estimate
            </a>
            <a
              href={`tel:${siteConfig.phone.replace(/\D/g, "")}`}
              class="block w-full text-center mt-3 rounded-lg border border-white/30 px-4 py-2.5 text-sm font-semibold text-white hover:bg-white/10 transition-colors"
            >
              Call {siteConfig.phone}
            </a>
          </div>

          <!-- Services Quick Links -->
          <div class="rounded-xl border border-border bg-surface-alt p-6">
            <h3 class="text-lg font-semibold text-text mb-4">Our Services</h3>
            <ul class="space-y-2">
              {services.map((service) => (
                <li>
                  <a
                    href={`/services/${service.id}`}
                    class="flex items-center gap-2 text-sm text-text-muted hover:text-primary transition-colors py-1"
                  >
                    <svg class="h-4 w-4 text-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                    </svg>
                    {service.data.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <!-- Other Areas -->
          {allAreas.length > 0 && (
            <div class="rounded-xl border border-border bg-surface-alt p-6">
              <h3 class="text-lg font-semibold text-text mb-4">Other Areas We Serve</h3>
              <ul class="space-y-2">
                {allAreas.map((otherArea) => (
                  <li>
                    <a
                      href={`/service-areas/${otherArea.id}`}
                      class="flex items-center gap-2 text-sm text-text-muted hover:text-primary transition-colors py-1"
                    >
                      <svg class="h-4 w-4 text-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                      </svg>
                      {otherArea.data.city}, {otherArea.data.state}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </aside>
      </div>
    </div>
  </section>

  <CTABanner
    title={`Need Service in ${city}?`}
    subtitle={`${siteConfig.businessName} is ready to help. Call us or request a free estimate today.`}
  />
</BaseLayout>
