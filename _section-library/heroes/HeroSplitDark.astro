---
/*
  HERO — SPLIT DARK
  Two-column hero: large image on the left, dark panel on the right
  with eyebrow, headline, subtitle, and CTA button.
  Below both columns: a white values bar with 3 icon+text items.
  
  Feels bold and premium. Great for contractors who want a strong
  first impression with a hero image showing their work.
  
  Props:
  - eyebrow, headline, subtitle: text content
  - imageSrc/imageAlt: left-side image
  - ctaLabel/ctaHref: primary CTA button
  - values: array of { icon, title, description } for the bottom bar
*/
import { siteConfig } from "../../src/config/siteConfig";
import Icon from "../../src/components/Icon.astro";

interface ValueItem {
  icon?: string;
  title: string;
  description: string;
}

interface Props {
  eyebrow?: string;
  headline?: string;
  subtitle?: string;
  imageSrc?: string;
  imageAlt?: string;
  ctaLabel?: string;
  ctaHref?: string;
  values?: ValueItem[];
}

const defaultValues: ValueItem[] = [
  {
    icon: "star",
    title: "Craftsmanship",
    description: "Precision and durability in every project.",
  },
  {
    icon: "shield",
    title: "Integrity",
    description: "Honesty and transparency in all dealings.",
  },
  {
    icon: "users",
    title: "Community",
    description: "Enhancing neighborhoods with care and professionalism.",
  },
];

const {
  eyebrow = siteConfig.businessName,
  headline = `Expert Service in ${siteConfig.address.city}`,
  subtitle = `Building trust with quality craftsmanship and integrity.`,
  imageSrc = "/images/hero.jpg",
  imageAlt = "Professional work by " + siteConfig.businessName,
  ctaLabel = "Get Your Free Estimate",
  ctaHref = "/contact",
  values = defaultValues,
} = Astro.props;
---

<section>
  <div class="grid grid-cols-1 lg:grid-cols-2">
    <!-- Left: Image -->
    <div class="relative min-h-[300px] sm:min-h-[400px] lg:min-h-[520px]">
      <img
        src={imageSrc}
        alt={imageAlt}
        class="absolute inset-0 h-full w-full object-cover"
        loading="eager"
        fetchpriority="high"
      />
    </div>

    <!-- Right: Dark content panel -->
    <div class="flex items-center bg-gray-950 px-8 sm:px-12 lg:px-16 py-14 sm:py-20">
      <div class="max-w-lg">
        {eyebrow && (
          <p class="text-secondary font-bold text-sm sm:text-base tracking-wide uppercase mb-3">
            {eyebrow}
          </p>
        )}
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white uppercase leading-tight">
          {headline}
        </h1>
        {subtitle && (
          <p class="mt-4 text-lg text-white/70">
            {subtitle}
          </p>
        )}
        <div class="mt-8">
          <a
            href={ctaHref}
            class="inline-block border-2 border-white px-7 py-3 text-sm font-bold text-white uppercase tracking-wider hover:bg-white hover:text-gray-950 transition-colors"
          >
            {ctaLabel}
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Values bar -->
  {values.length > 0 && (
    <div class="bg-white border-t border-border shadow-sm">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-6">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 sm:gap-8">
          {values.map((v) => (
            <div class="flex items-start gap-4">
              {v.icon && (
                <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-primary/10">
                  <Icon name={v.icon} class="h-6 w-6 text-primary" />
                </div>
              )}
              <div>
                <h3 class="font-bold text-text">{v.title}</h3>
                <p class="text-sm text-text-muted mt-0.5">{v.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  )}
</section>
