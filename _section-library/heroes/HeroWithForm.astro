---
/*
  HERO — WITH INLINE LEAD FORM
  Full-width background image with dark overlay. Left side has eyebrow text,
  large headline, description paragraph, bullet points with checkmarks, and
  a phone CTA button. Right side has a "Get In Touch" lead capture form.
  
  Uses the shared LeadForm component — same form everywhere, one place to maintain.
  
  Best for: service pages where you want to capture leads immediately.
  Great for high-intent pages like "Storm Damage Repair" or "Emergency Plumbing".
*/
import { siteConfig } from "../../src/config/siteConfig";
import LeadForm from "../../src/components/LeadForm.astro";

interface Props {
  eyebrow?: string;
  headline?: string;
  description?: string;
  bullets?: string[];
  backgroundImage?: string;
  formHeading?: string;
}

const {
  eyebrow = `Expert Service in ${siteConfig.serviceArea}`,
  headline = `Professional Service in ${siteConfig.address.city}, ${siteConfig.address.state}`,
  description = `Protect your home with our top-rated services. At ${siteConfig.businessName}, we ensure your property is in its best condition, providing safety and peace of mind.`,
  bullets = [
    `Serving ${siteConfig.serviceArea} & Surrounding Areas`,
    "Professional and Reliable",
    "100% Quality Guaranteed",
    "5-Star Rated",
  ],
  backgroundImage = "/images/hero.jpg",
  formHeading = "Get In Touch",
} = Astro.props;
---

<section class="relative overflow-hidden bg-gray-900 text-white">
  <div class="absolute inset-0 z-0">
    <img
      src={backgroundImage}
      alt=""
      class="h-full w-full object-cover opacity-25"
      loading="eager"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-primary-dark/95 via-primary-dark/85 to-primary-dark/70"></div>
  </div>

  <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16 sm:py-20 lg:py-24">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">
      <!-- Left: Copy -->
      <div>
        <p class="text-sm sm:text-base font-semibold text-secondary-light tracking-wide uppercase mb-4">
          {eyebrow}
        </p>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold leading-tight">
          {headline}
        </h1>
        <p class="mt-5 text-base sm:text-lg text-gray-300 leading-relaxed max-w-xl">
          {description}
        </p>

        <ul class="mt-6 space-y-3">
          {bullets.map((bullet) => (
            <li class="flex items-center gap-3">
              <svg class="h-5 w-5 text-accent-light shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-sm sm:text-base text-gray-200">{bullet}</span>
            </li>
          ))}
        </ul>

        <div class="mt-8">
          <a
            href={`tel:${siteConfig.phone.replace(/\D/g, "")}`}
            class="inline-flex items-center gap-2 rounded-lg bg-secondary px-6 py-3.5 text-base font-bold text-white shadow-lg hover:bg-secondary-light transition-colors"
          >
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            Call Us: {siteConfig.phone}
          </a>
        </div>
      </div>

      <!-- Right: Lead Form -->
      <div class="bg-white/95 backdrop-blur rounded-xl shadow-2xl p-6 sm:p-8">
        <h2 class="flex items-center gap-2 text-xl sm:text-2xl font-bold text-text mb-6">
          <svg class="h-6 w-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          {formHeading}
        </h2>
        <LeadForm formId="hero-lead-form" variant="full" submitLabel="Submit">
          <slot name="service-options" slot="service-options" />
        </LeadForm>
      </div>
    </div>
  </div>
</section>
