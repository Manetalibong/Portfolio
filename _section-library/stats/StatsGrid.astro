---
/*
 * Four stat “cards” in a 2×2 grid on a soft surface-alt background—numbers in primary,
 * labels muted. Use on about pages or beside case studies where you want proof without a full bar.
 */
import { siteConfig } from "../../src/config/siteConfig";

export interface Stat {
  value: string;
  label: string;
}

export interface Props {
  stats?: Stat[];
}

const defaultStats: Stat[] = [
  { value: "15+", label: "Years Experience" },
  { value: "500+", label: "Projects Completed" },
  { value: "5★", label: "Google Rating" },
  { value: "24/7", label: "Emergency Service" },
];

const { stats = defaultStats } = Astro.props;
---

<section
  class="bg-surface-alt px-4 py-14 sm:px-6 lg:px-8 lg:py-20"
  aria-label={`${siteConfig.businessName} highlights`}
>
  <div class="mx-auto max-w-4xl">
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 sm:gap-5">
      {
        stats.map((s) => (
          <div class="rounded-xl border border-border bg-surface px-6 py-8 text-center shadow-sm">
            <p class="font-heading text-4xl font-bold tabular-nums text-primary sm:text-5xl">{s.value}</p>
            <p class="mt-2 text-sm font-medium text-text-muted sm:text-base">{s.label}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
